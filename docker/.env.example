# 团圆寻亲系统 - 生产环境环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# 警告：请勿将包含真实密码的 .env 文件提交到版本控制！

# ============================================
# 数据库配置
# ============================================
DB_USER=postgres
DB_PASSWORD=YourStrongPasswordHere123!
DB_NAME=cntuanyuan

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=YourRedisPasswordHere

# ============================================
# JWT 密钥配置（重要！必须修改！）
# 使用以下命令生成强密钥：
# openssl rand -base64 32
# ============================================
JWT_SECRET=ChangeThisToYourRandomSecretKey32Chars!

# ============================================
# 微信小程序配置（如启用微信登录）
# ============================================
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_ENABLE_LOGIN=true

# ============================================
# 存储配置
# local: 本地存储（默认）
# oss: 阿里云对象存储
# cos: 腾讯云对象存储
# ============================================
STORAGE_TYPE=local
STORAGE_BASE_URL=https://your-domain.com/uploads

# 阿里云 OSS 配置（如使用）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=

# 腾讯云 COS 配置（如使用）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# ============================================
# 短信服务配置
# ============================================
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=团圆寻亲
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_SECRET=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=

# ============================================
# 系统功能开关
# ============================================
ENABLE_REGISTER=true
ENABLE_WECHAT_LOGIN=true
ENABLE_SMS_LOGIN=false
