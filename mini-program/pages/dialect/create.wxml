<view class="page">
  <view class="template-card" wx:if="{{cards.length > 0}}">
    <view class="template-head">
      <text class="title">方言卡片录入</text>
      <text class="progress">{{completedCount}} / {{cards.length}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{cards.length ? (completedCount / cards.length) * 100 : 0}}%"></view>
    </view>

    <view class="card-main">
      <image
        wx:if="{{currentCard.image_url}}"
        class="card-image"
        src="{{currentCard.image_url}}"
        mode="aspectFill"
      />
      <view wx:else class="card-image card-image-empty">当前卡片未配置图片</view>
      <view class="card-group">{{currentCard.group_name || '未分组'}}</view>
      <text class="card-text" wx:if="{{currentCard.content}}">{{currentCard.content}}</text>
      <text class="card-text card-text-placeholder" wx:else>请根据上方图片内容进行录音</text>
      <view class="card-index">卡片 {{currentCardIndex + 1}} / {{cards.length}}</view>
    </view>

    <scroll-view class="card-list" scroll-x enable-flex>
      <view
        wx:for="{{cards}}"
        wx:key="id"
        class="chip {{currentCardIndex === index ? 'active' : ''}} {{recordings[item.id] ? 'done' : ''}}"
        data-index="{{index}}"
        bindtap="switchCard"
      >
        <text>{{item.content || ('卡片' + (index + 1))}}</text>
      </view>
    </scroll-view>

    <view class="card-nav">
      <button class="nav-btn" bindtap="goPrevCard" disabled="{{currentCardIndex <= 0}}">上一张</button>
      <button class="nav-btn" bindtap="goNextCard" disabled="{{currentCardIndex >= cards.length - 1}}">下一张</button>
    </view>
  </view>

  <view class="empty" wx:else>
    暂无可录入卡片模板，请联系管理员配置
  </view>

  <view class="record-card" wx:if="{{currentCard}}">
    <view class="record-title">当前卡片录音</view>
    <text class="record-tip" wx:if="{{!isRecording && !hasRecorded}}">点击开始录音，时长 {{minDuration}}-{{maxDuration}} 秒</text>
    <text class="record-tip recording" wx:if="{{isRecording}}">录音中 {{recordTimeText}}（最少 {{minDuration}} 秒）</text>
    <text class="record-tip" wx:if="{{!isRecording && hasRecorded}}">录音完成 {{recordDurationText}}</text>

    <view class="btn-row">
      <button class="warn" bindtap="resetCurrentRecord" disabled="{{!hasRecorded || isRecording}}">重录</button>
      <button class="primary" bindtap="{{isRecording ? 'stopRecord' : 'startRecord'}}">{{isRecording ? '停止录音' : '开始录音'}}</button>
      <button class="ghost" bindtap="togglePlay" disabled="{{!hasRecorded}}">{{isPlaying ? '暂停试听' : '试听'}}</button>
    </view>

    <view class="playback" wx:if="{{hasRecorded}}">
      <slider
        value="{{playProgress}}"
        activeColor="#FF8C42"
        backgroundColor="#F3E6D9"
        bindchange="onPlayProgressChange"
      />
      <view class="time-row">
        <text>{{playCurrentTimeText}}</text>
        <text>{{recordDurationText}}</text>
      </view>
    </view>
  </view>

  <view class="step-tip" wx:if="{{!allCardsRecorded}}">
    请先完成全部卡片录音，再填写采集信息
  </view>

  <view class="form-card" wx:if="{{allCardsRecorded}}">
    <view class="field">
      <view class="label">采集地区 <text class="required">*</text></view>
      <picker mode="region" value="{{[form.province, form.city, form.district]}}" bindchange="onRegionChange">
        <view class="picker {{form.region ? 'has-value' : ''}}">{{form.region || '请选择省/市/区'}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">采集地址 <text class="required">*</text></view>
      <button class="location-btn" bindtap="chooseCollectLocation">地图选点</button>
      <view class="readonly {{form.collect_address ? 'has-value' : ''}}">
        {{form.collect_address || '请点击上方“地图选点”获取地址'}}
      </view>
      <text class="coord" wx:if="{{form.collect_latitude && form.collect_longitude}}">
        坐标：{{form.collect_latitude}}, {{form.collect_longitude}}
      </text>
    </view>

    <view class="field">
      <view class="label">关联走失人员（选填）</view>
      <view wx:if="{{selectedMissingPerson}}" class="selected-person">
        <text class="name">{{selectedMissingPerson.name || '未知'}}</text>
        <text class="remove" bindtap="clearMissingPerson">清除</text>
      </view>
      <button wx:else class="ghost" bindtap="showMissingPersonSelector">选择走失人员</button>
    </view>

    <view class="field">
      <view class="label">补充说明（选填）</view>
      <textarea
        class="textarea"
        maxlength="500"
        value="{{form.description}}"
        bindinput="onDescInput"
        placeholder="可填写方言背景、口音说明等"
      />
      <view class="counter">{{form.description.length}}/500</view>
    </view>
  </view>

  <view class="submit-wrap" wx:if="{{allCardsRecorded}}">
    <button class="submit" loading="{{isUploading}}" bindtap="submitForm" disabled="{{isUploading || !cards.length}}">
      {{isUploading ? ('上传中 ' + uploadProgress + '%') : '提交整套方言录入'}}
    </button>
  </view>

  <view class="picker-mask" wx:if="{{showMissingPersonPicker}}" bindtap="hideMissingPersonSelector"></view>
  <view class="picker-panel" wx:if="{{showMissingPersonPicker}}">
    <view class="picker-head">
      <text>选择走失人员</text>
      <text class="close" bindtap="hideMissingPersonSelector">关闭</text>
    </view>
    <scroll-view class="picker-list" scroll-y>
      <view class="person-item" wx:for="{{missingPersonList}}" wx:key="id" data-index="{{index}}" bindtap="selectMissingPerson">
        <text class="name">{{item.name || '未知'}}</text>
        <text class="meta">{{item.missing_region || item.region || ''}}</text>
      </view>
      <view class="empty" wx:if="{{missingPersonList.length === 0}}">暂无走失人员数据</view>
    </scroll-view>
  </view>
</view>
