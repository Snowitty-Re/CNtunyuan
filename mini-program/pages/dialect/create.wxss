/* ===== Page Base ===== */
.page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: 60rpx;
}

/* ===== Record Hero ===== */
.record-hero {
  position: relative;
  overflow: hidden;
  padding: 50rpx 30rpx 60rpx;
}

.record-hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #FF8C42 0%, #E06818 50%, #C85A18 100%);
}

.rh-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

.rh-circle-1 { width: 280rpx; height: 280rpx; top: -80rpx; right: -60rpx; }
.rh-circle-2 { width: 200rpx; height: 200rpx; bottom: -60rpx; left: -40rpx; }

.record-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== Wave Animation (recording) ===== */
.wave-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  pointer-events: none;
}

.wave-ring {
  position: absolute;
  top: 50%; left: 50%;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.15);
  transform: translate(-50%, -50%);
  animation: waveExpand 3s ease-out infinite;
}

.wave-ring-1 { animation-delay: 0s; }
.wave-ring-2 { animation-delay: 0.75s; }
.wave-ring-3 { animation-delay: 1.5s; }
.wave-ring-4 { animation-delay: 2.25s; }

@keyframes waveExpand {
  0% { width: 160rpx; height: 160rpx; opacity: 0.8; }
  100% { width: 400rpx; height: 400rpx; opacity: 0; }
}

/* Sound wave bars */
.record-wave-bars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.rw-bar {
  width: 5rpx;
  height: 20rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 3rpx;
  animation: rwAnim 0.8s ease-in-out infinite alternate;
}

@keyframes rwAnim {
  0% { height: 12rpx; opacity: 0.4; }
  100% { height: 60rpx; opacity: 1; }
}

/* Record status */
.record-status {
  text-align: center;
  margin-bottom: 30rpx;
}

.status-main {
  display: block;
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.recording-text {
  animation: textBlink 1.2s ease-in-out infinite;
}

@keyframes textBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.65; }
}

.status-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
}

/* ===== Preview Player ===== */
.preview-player {
  width: 100%;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.preview-wave-bars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 48rpx;
  margin-bottom: 16rpx;
}

.pvw-bar {
  width: 4rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 2rpx;
  min-height: 6rpx;
}

.pvw-bar.animating {
  background: rgba(255,255,255,0.7);
  animation: pvwAnim 0.6s ease-in-out infinite alternate;
}

@keyframes pvwAnim {
  0% { transform: scaleY(0.5); }
  100% { transform: scaleY(1.4); }
}

.preview-slider {
  margin: 0 -16rpx;
}

.preview-time {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.preview-time text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  font-variant-numeric: tabular-nums;
}

/* ===== Record Controls ===== */
.record-controls {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 60rpx;
  width: 100%;
}

.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.ctrl-spacer {
  visibility: hidden;
}

.ctrl-secondary.invisible {
  visibility: hidden;
}

/* Secondary button (re-record) */
.ctrl-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-icon-secondary {
  background: rgba(255,255,255,0.2);
  border: 2rpx solid rgba(255,255,255,0.3);
}

.icon-rerecord {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #fff;
  border-bottom: none;
  border-radius: 50%;
  position: relative;
}

.rerecord-arrow {
  position: absolute;
  bottom: -2rpx;
  right: -2rpx;
  width: 0; height: 0;
  border-top: 8rpx solid #fff;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  transform: rotate(40deg);
}

.ctrl-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* Primary button (record/stop/play) */
.ctrl-primary {
  position: relative;
}

.main-btn-outer {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
  transition: transform 0.15s ease;
  position: relative;
  z-index: 2;
}

.main-btn-outer:active {
  transform: scale(0.92);
}

.main-btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Mic dot (record icon) */
.icon-mic-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF4444, #CC2222);
  box-shadow: 0 4rpx 16rpx rgba(255,68,68,0.4);
}

/* Stop square */
.icon-stop-square {
  width: 46rpx;
  height: 46rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #FF4444, #CC2222);
}

/* Play triangle */
.icon-play-tri {
  width: 0; height: 0;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  border-left: 36rpx solid #FF8C42;
  margin-left: 8rpx;
}

/* Pause bars */
.icon-pause-duo {
  display: flex;
  gap: 10rpx;
}

.pd-bar {
  width: 10rpx;
  height: 40rpx;
  background: #FF8C42;
  border-radius: 5rpx;
}

/* Recording pulse */
.rec-pulse {
  position: absolute;
  top: 0; left: 50%;
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.3);
  transform: translateX(-50%);
  animation: recPulse 2s ease-out infinite;
  z-index: 1;
}

.rec-pulse-2 {
  animation-delay: 1s;
}

@keyframes recPulse {
  0% { width: 140rpx; height: 140rpx; opacity: 0.7; top: 0; }
  100% { width: 220rpx; height: 220rpx; opacity: 0; top: -40rpx; }
}

.main-btn-outer.recording {
  animation: recBtnPulse 1.5s ease-in-out infinite;
}

@keyframes recBtnPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,68,68,0.3); }
  50% { box-shadow: 0 0 0 16rpx rgba(255,68,68,0); }
}

.ctrl-label-main {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
  position: relative;
  z-index: 2;
}

/* ===== Form Card ===== */
.form-card {
  background: #fff;
  margin: -24rpx 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  z-index: 3;
  box-shadow: 0 8rpx 40rpx rgba(139,90,43,0.08);
}

.field {
  margin-bottom: 36rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 8rpx;
}

.field-label-text {
  font-size: 30rpx;
  color: #2D2117;
  font-weight: 600;
}

.field-required {
  font-size: 28rpx;
  color: #FF5252;
  font-weight: 600;
}

.field-optional {
  font-size: 24rpx;
  color: #BBA898;
  font-weight: 400;
}

.field-hint {
  font-size: 24rpx;
  color: #BBA898;
  font-weight: 400;
}

/* Input */
.field-input-wrap {
  background: #FDF8F3;
  border: 2rpx solid #F0E6DB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  transition: border-color 0.2s ease;
}

.field-input-wrap:focus-within {
  border-color: #FF8C42;
}

.field-input {
  height: 88rpx;
  font-size: 28rpx;
  color: #2D2117;
  width: 100%;
}

/* Textarea */
.field-textarea-wrap {
  background: #FDF8F3;
  border: 2rpx solid #F0E6DB;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  position: relative;
}

.field-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #2D2117;
  line-height: 1.6;
}

.textarea-counter {
  position: absolute;
  bottom: 12rpx;
  right: 20rpx;
  font-size: 22rpx;
  color: #C0A88E;
}

/* Picker */
.field-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
  background: #FDF8F3;
  border: 2rpx solid #F0E6DB;
  border-radius: 16rpx;
}

.picker-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-left text {
  font-size: 28rpx;
  color: #C0A88E;
}

.field-picker.has-value .picker-left text {
  color: #2D2117;
}

.picker-pin {
  width: 18rpx;
  height: 18rpx;
  background: #FF8C42;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.picker-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #C0A88E;
  border-bottom: 3rpx solid #C0A88E;
  transform: rotate(-45deg);
}

/* ===== Tags ===== */
.tag-input-row {
  display: flex;
  gap: 14rpx;
}

.tag-input-wrap {
  flex: 1;
  background: #FDF8F3;
  border: 2rpx solid #F0E6DB;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.tag-input {
  height: 80rpx;
  font-size: 28rpx;
  color: #2D2117;
  width: 100%;
}

.tag-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  background: #F0E6DB;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tag-add-btn text {
  font-size: 28rpx;
  color: #BBA898;
  font-weight: 500;
}

.tag-add-btn.active {
  background: #FF8C42;
}

.tag-add-btn.active text {
  color: #fff;
}

/* Tags display */
.tags-display {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #FFF5EC;
  border: 1rpx solid #FFE4CC;
  border-radius: 24rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #D47A3A;
  font-weight: 500;
}

.tag-remove {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-x {
  position: relative;
  width: 16rpx;
  height: 16rpx;
}

.x-line {
  position: absolute;
  width: 16rpx;
  height: 2rpx;
  background: #D47A3A;
  top: 50%; left: 0;
}

.x-line-1 { transform: rotate(45deg); }
.x-line-2 { transform: rotate(-45deg); }

/* Popular tags */
.popular-section {
  margin-top: 20rpx;
}

.popular-label {
  font-size: 24rpx;
  color: #BBA898;
  display: block;
  margin-bottom: 14rpx;
}

.popular-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.popular-chip {
  padding: 10rpx 24rpx;
  background: #FDF8F3;
  border: 2rpx solid #F0E6DB;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.popular-chip text {
  font-size: 26rpx;
  color: #8C7A6B;
}

.popular-chip:active {
  background: #FFF5EC;
  border-color: #FF8C42;
}

.popular-chip.used {
  opacity: 0.4;
  pointer-events: none;
}

/* ===== Missing Person Selection ===== */
.selected-person-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FDF8F3;
  border: 2rpx solid #F0E6DB;
  border-radius: 16rpx;
}

.sp-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #FFE4CC;
  background: #FAF0E6;
  flex-shrink: 0;
}

.sp-info {
  flex: 1;
  min-width: 0;
}

.sp-name {
  font-size: 30rpx;
  color: #2D2117;
  font-weight: 600;
  display: block;
}

.sp-region {
  font-size: 24rpx;
  color: #BBA898;
  margin-top: 6rpx;
  display: block;
}

.sp-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0E6DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sp-x {
  position: relative;
  width: 18rpx;
  height: 18rpx;
}

.spx-line {
  position: absolute;
  width: 18rpx;
  height: 3rpx;
  background: #8C7A6B;
  top: 50%; left: 0;
  border-radius: 2rpx;
}

.spx-1 { transform: rotate(45deg); }
.spx-2 { transform: rotate(-45deg); }

/* Select person button */
.select-person-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  border: 3rpx dashed #E0D2C4;
  border-radius: 16rpx;
  transition: border-color 0.2s ease;
}

.select-person-btn:active {
  border-color: #FF8C42;
}

.spb-plus {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42, #E07030);
  position: relative;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255,140,66,0.3);
}

.plus-h, .plus-v {
  position: absolute;
  background: #fff;
  border-radius: 2rpx;
}

.plus-h {
  width: 20rpx; height: 3rpx;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}

.plus-v {
  width: 3rpx; height: 20rpx;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}

.spb-text {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: 500;
}

/* ===== Submit ===== */
.submit-section {
  padding: 0 24rpx;
  text-align: center;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: linear-gradient(135deg, #FF8C42, #E06818);
  border-radius: 50rpx;
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,140,66,0.35);
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(255,140,66,0.3);
}

.submit-btn.uploading {
  opacity: 0.75;
}

.submit-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top: 4rpx solid #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.submit-note {
  display: block;
  font-size: 24rpx;
  color: #BBA898;
  margin-top: 20rpx;
}

/* ===== Modal Sheet ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(45,33,23,0.45);
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-sheet.show {
  transform: translateY(0);
}

.modal-handle-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.handle-line {
  width: 60rpx;
  height: 6rpx;
  background: #E0D2C4;
  border-radius: 3rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D2117;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0E6DB;
  border-radius: 50%;
}

.close-x {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}

.cx-line {
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: #8C7A6B;
  top: 50%; left: 0;
  border-radius: 2rpx;
}

.cx-1 { transform: rotate(45deg); }
.cx-2 { transform: rotate(-45deg); }

.modal-list {
  flex: 1;
  max-height: 58vh;
  padding: 0 16rpx 24rpx;
}

.modal-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  transition: background 0.15s ease;
}

.modal-item:active {
  background: #FDF8F3;
}

.modal-item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #FFE4CC;
  background: #FAF0E6;
  flex-shrink: 0;
}

.modal-item-info {
  flex: 1;
  min-width: 0;
}

.modal-item-name {
  font-size: 30rpx;
  color: #2D2117;
  font-weight: 600;
  display: block;
}

.modal-item-region {
  font-size: 26rpx;
  color: #BBA898;
  margin-top: 6rpx;
  display: block;
}

.modal-item-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mia-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #C0A88E;
  border-bottom: 3rpx solid #C0A88E;
  transform: rotate(-45deg);
}

.modal-empty {
  text-align: center;
  padding: 80rpx 0;
}

.modal-empty text {
  font-size: 28rpx;
  color: #BBA898;
}
