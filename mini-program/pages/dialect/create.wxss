.page {
  min-height: 100vh;
  background: #FDF8F3;
  padding: 14rpx;
  box-sizing: border-box;
}

.template-card,
.record-card,
.form-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}

.template-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D1F10;
}

.progress {
  font-size: 24rpx;
  color: #FF8C42;
}

.progress-bar {
  margin-top: 10rpx;
  height: 10rpx;
  background: #F5EBDD;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #FFAA66 0%, #FF8C42 100%);
  border-radius: 999rpx;
}

.card-main {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #FFF7EE;
}

.card-group {
  font-size: 20rpx;
  color: #A5662A;
}

.card-text {
  display: block;
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D1F10;
}

.card-text-placeholder {
  font-size: 26rpx;
  font-weight: 500;
  color: #8C7B6B;
}

.card-image {
  width: 100%;
  height: 560rpx;
  border-radius: 16rpx;
  margin-top: 10rpx;
  background: #F7F7F7;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

.card-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #B5A08C;
  background: repeating-linear-gradient(
    -45deg,
    #FAF3EB 0rpx,
    #FAF3EB 24rpx,
    #FFF8F1 24rpx,
    #FFF8F1 48rpx
  );
}

.card-index {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8C7B6B;
}

.card-list {
  margin-top: 10rpx;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  margin-right: 10rpx;
  border: 1rpx solid #EED9C0;
  color: #8C7B6B;
  background: #fff;
  font-size: 22rpx;
}

.chip.active {
  color: #fff;
  background: #FF8C42;
  border-color: #FF8C42;
}

.chip.done {
  border-color: #53C41A;
}

.card-nav {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.nav-btn {
  flex: 1;
  background: #FFF7EE;
  color: #A5662A;
  border-radius: 10rpx;
}

.record-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D1F10;
}

.record-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8C7B6B;
}

.recording {
  color: #FF4D4F;
}

.btn-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.btn-row button {
  flex: 1;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.primary {
  background: #FF8C42;
  color: #fff;
}

.ghost {
  background: #F2F4F8;
  color: #5A6573;
}

.warn {
  background: #FFF1F0;
  color: #CF1322;
}

.playback {
  margin-top: 14rpx;
}

.time-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8C7B6B;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  font-size: 25rpx;
  color: #5B4A39;
  margin-bottom: 8rpx;
}

.required {
  color: #FF4D4F;
}

.picker,
.readonly,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #EED9C0;
  border-radius: 12rpx;
  background: #FFFDF8;
  color: #8C7B6B;
  font-size: 25rpx;
}

.picker,
.readonly {
  min-height: 78rpx;
  padding: 20rpx;
}

.picker.has-value,
.readonly.has-value {
  color: #2D1F10;
}

.location-btn {
  margin-bottom: 10rpx;
  background: #FFF7EE;
  color: #A5662A;
  border-radius: 10rpx;
}

.coord {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8C7B6B;
}

.textarea {
  min-height: 180rpx;
  padding: 16rpx;
}

.counter {
  text-align: right;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B5A08C;
}

.selected-person {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 78rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #EED9C0;
  background: #FFFDF8;
}

.name {
  font-size: 25rpx;
  color: #2D1F10;
}

.remove {
  font-size: 24rpx;
  color: #FF4D4F;
}

.submit-wrap {
  margin-top: 22rpx;
  margin-bottom: 24rpx;
}

.submit {
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #FF9D55 0%, #FF8C42 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.step-tip {
  margin: 8rpx 0 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #FFF7E6;
  color: #D46B08;
  font-size: 24rpx;
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.picker-head {
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #2D1F10;
}

.close {
  color: #8C7B6B;
  font-size: 24rpx;
}

.picker-list {
  flex: 1;
}

.person-item {
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.meta {
  display: block;
  font-size: 22rpx;
  color: #8C7B6B;
  margin-top: 6rpx;
}

.empty {
  text-align: center;
  color: #8C7B6B;
  font-size: 24rpx;
  padding: 36rpx 0;
}
