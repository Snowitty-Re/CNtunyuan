/* ===== Page Base ===== */
.page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: 160rpx;
}

/* ===== Header ===== */
.page-header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #E07030 50%, #D45A20 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -30rpx; right: -40rpx;
  width: 240rpx; height: 240rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -60rpx; left: -30rpx;
  width: 180rpx; height: 180rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 2;
  padding: 60rpx 40rpx 50rpx;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.header-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-sound-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
}

.hw-bar {
  width: 6rpx;
  background: #fff;
  border-radius: 3rpx;
  animation: headerWave 1.2s ease-in-out infinite;
}

.hw-bar-1 { height: 20rpx; animation-delay: 0s; }
.hw-bar-2 { height: 36rpx; animation-delay: 0.15s; }
.hw-bar-3 { height: 48rpx; animation-delay: 0.3s; }
.hw-bar-4 { height: 32rpx; animation-delay: 0.45s; }
.hw-bar-5 { height: 24rpx; animation-delay: 0.6s; }

@keyframes headerWave {
  0%, 100% { transform: scaleY(0.5); }
  50% { transform: scaleY(1); }
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* ===== Region Filter ===== */
.filter-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FDF8F3;
  padding: 20rpx 30rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.region-picker-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 40rpx;
  border: 2rpx solid #F0E6DB;
  box-shadow: 0 2rpx 12rpx rgba(139,90,43,0.06);
}

.region-picker-pin {
  width: 18rpx;
  height: 18rpx;
  background: #FF8C42;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.region-picker-text {
  font-size: 28rpx;
  color: #2D2117;
  font-weight: 600;
}

.region-picker-arrow {
  width: 0; height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #C0A88E;
  margin-left: 4rpx;
}

.filter-count-badge {
  padding: 10rpx 24rpx;
  background: #FFF5EC;
  border-radius: 24rpx;
  border: 1rpx solid #FFE4CC;
}

.filter-count-badge text {
  font-size: 24rpx;
  color: #D47A3A;
  font-weight: 500;
}

/* ===== Dialect List ===== */
.dialect-list {
  padding: 8rpx 24rpx;
}

/* ===== Dialect Card ===== */
.dialect-card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(139,90,43,0.06);
  overflow: hidden;
  transition: transform 0.15s ease;
}

.dialect-card:active {
  transform: scale(0.985);
}

/* Card wave decoration */
.card-wave-decoration {
  position: absolute;
  top: 0; right: 0;
  width: 180rpx; height: 120rpx;
  opacity: 0.06;
  overflow: hidden;
}

.wave-line {
  position: absolute;
  right: -20rpx;
  border-radius: 50%;
  border: 3rpx solid #FF8C42;
}

.wave-line-1 { width: 100rpx; height: 100rpx; top: -30rpx; right: -10rpx; }
.wave-line-2 { width: 140rpx; height: 140rpx; top: -40rpx; right: -20rpx; }
.wave-line-3 { width: 180rpx; height: 180rpx; top: -50rpx; right: -30rpx; }

/* Card top */
.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2117;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.featured-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.featured-badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.featured-star {
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

/* Card description */
.card-desc {
  margin-bottom: 16rpx;
}

.card-desc text {
  font-size: 26rpx;
  color: #8C7A6B;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== Audio Player Row ===== */
.card-player {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF5EC, #FFF0E3);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.play-btn {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.play-btn-inner {
  position: relative;
  z-index: 2;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42, #E07030);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255,140,66,0.4);
  transition: transform 0.15s ease;
}

.play-btn:active .play-btn-inner {
  transform: scale(0.9);
}

.icon-play-triangle {
  width: 0; height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 24rpx solid #fff;
  margin-left: 6rpx;
}

.icon-pause-bars {
  display: flex;
  gap: 6rpx;
}

.p-bar {
  width: 6rpx;
  height: 24rpx;
  background: #fff;
  border-radius: 3rpx;
}

/* Pulse rings */
.pulse-ring {
  position: absolute;
  top: 50%; left: 50%;
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,140,66,0.3);
  transform: translate(-50%, -50%);
  animation: pulseRing 1.8s ease-out infinite;
}

.pulse-ring-2 {
  animation-delay: 0.9s;
}

@keyframes pulseRing {
  0% { width: 80rpx; height: 80rpx; opacity: 1; }
  100% { width: 140rpx; height: 140rpx; opacity: 0; }
}

/* Sound bars */
.card-sound-bars {
  display: flex;
  align-items: center;
  gap: 5rpx;
  flex: 1;
  height: 52rpx;
  margin-right: 16rpx;
}

.s-bar {
  width: 5rpx;
  min-height: 8rpx;
  background: #FFBB84;
  border-radius: 3rpx;
  opacity: 0.5;
  transition: opacity 0.3s ease;
}

.s-bar.animating {
  opacity: 1;
  animation: soundBar 0.8s ease-in-out infinite alternate;
}

@keyframes soundBar {
  0% { transform: scaleY(0.4); }
  100% { transform: scaleY(1.4); }
}

.card-duration {
  flex-shrink: 0;
}

.card-duration text {
  font-size: 24rpx;
  color: #C08050;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* ===== Tags ===== */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tag-chip {
  padding: 6rpx 18rpx;
  background: #FFF5EC;
  border-radius: 20rpx;
  border: 1rpx solid #FFE4CC;
}

.tag-chip text {
  font-size: 22rpx;
  color: #D47A3A;
  font-weight: 500;
}

/* ===== Meta Row ===== */
.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.meta-region {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.region-pin {
  width: 20rpx;
  height: 20rpx;
  background: #FF8C42;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  position: relative;
}

.region-pin::after {
  content: '';
  position: absolute;
  width: 8rpx; height: 8rpx;
  background: #fff;
  border-radius: 50%;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}

.meta-region text {
  font-size: 24rpx;
  color: #A08672;
}

.meta-stats {
  display: flex;
  gap: 24rpx;
}

.stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat text {
  font-size: 24rpx;
  color: #A08672;
  font-variant-numeric: tabular-nums;
}

.stat-icon-play {
  width: 0; height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid #C0A88E;
}

.stat-icon-heart {
  width: 16rpx;
  height: 14rpx;
  position: relative;
}

.stat-icon-heart::before,
.stat-icon-heart::after {
  content: '';
  position: absolute;
  width: 9rpx; height: 14rpx;
  background: #C0A88E;
  border-radius: 9rpx 9rpx 0 0;
}

.stat-icon-heart::before {
  left: 0; top: 0;
  transform: rotate(-45deg);
  transform-origin: bottom right;
}

.stat-icon-heart::after {
  right: 0; top: 0;
  transform: rotate(45deg);
  transform-origin: bottom left;
}

/* ===== Card Footer ===== */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  border-top: 2rpx solid #FAF0E6;
}

.collector {
  display: flex;
  align-items: center;
}

.collector-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid #FFE4CC;
  background: #FAF0E6;
}

.collector-name {
  font-size: 24rpx;
  color: #8C7A6B;
  font-weight: 500;
}

.card-time {
  font-size: 22rpx;
  color: #BBA898;
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx 80rpx;
}

.empty-mic {
  position: relative;
  width: 120rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.empty-mic-body {
  width: 60rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #FFD5B5, #FFBB84);
  border-radius: 30rpx;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.empty-mic-base {
  width: 90rpx;
  height: 50rpx;
  border: 4rpx solid #FFBB84;
  border-top: none;
  border-radius: 0 0 50rpx 50rpx;
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
}

.empty-mic-stand {
  width: 4rpx;
  height: 30rpx;
  background: #FFBB84;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}

.empty-mic-stand::after {
  content: '';
  width: 50rpx;
  height: 4rpx;
  background: #FFBB84;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #8C7A6B;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #BBA898;
}

/* ===== Load More ===== */
.load-more {
  padding: 40rpx 0 20rpx;
}

.load-more-inner {
  display: flex;
  justify-content: center;
  align-items: center;
}

.load-more-text {
  font-size: 26rpx;
  color: #BBA898;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #FF8C42;
  border-radius: 50%;
  animation: dotBounce 1.2s ease-in-out infinite;
}

.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ===== FAB (Floating Action Button) ===== */
.fab-wrapper {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  z-index: 1000;
}

.fab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(135deg, #FF8C42, #E06818);
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(255,140,66,0.45), 0 2rpx 8rpx rgba(255,140,66,0.25);
  transition: transform 0.2s ease;
  position: relative;
}

.fab::before {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,140,66,0.2);
}

.fab:active {
  transform: scale(0.88);
}

.fab.animate {
  animation: fabPress 0.25s ease;
}

@keyframes fabPress {
  0% { transform: scale(1); }
  50% { transform: scale(0.85); }
  100% { transform: scale(1); }
}

.fab-mic-icon {
  width: 24rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 12rpx;
  position: relative;
}

.fab-mic-icon::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 20rpx;
  border: 3rpx solid #fff;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
}

.fab-label {
  font-size: 20rpx;
  color: #fff;
  margin-top: 14rpx;
  font-weight: 500;
}
