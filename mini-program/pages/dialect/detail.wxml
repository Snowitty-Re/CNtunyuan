<view class="page">
  <!-- Loading state -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-circle">
      <view class="loading-ring"></view>
      <view class="loading-mic"></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Content -->
  <block wx:if="{{!loading && dialect}}">
    <!-- Hero audio player section -->
    <view class="player-hero">
      <view class="player-hero-bg">
        <view class="hero-circle hero-circle-1"></view>
        <view class="hero-circle hero-circle-2"></view>
        <view class="hero-circle hero-circle-3"></view>
      </view>

      <view class="player-content">
        <!-- Title -->
        <text class="player-title">{{dialect.title || '方言录音'}}</text>

        <!-- Large play button -->
        <view class="play-btn-large {{isPlaying ? 'playing' : ''}}" bindtap="togglePlay">
          <view class="play-btn-outer-ring"></view>
          <view class="play-btn-body">
            <view wx:if="{{!isPlaying}}" class="icon-play-lg"></view>
            <view wx:else class="icon-pause-lg">
              <view class="pause-bar-lg"></view>
              <view class="pause-bar-lg"></view>
            </view>
          </view>
          <!-- Animated rings when playing -->
          <view class="play-pulse play-pulse-1" wx:if="{{isPlaying}}"></view>
          <view class="play-pulse play-pulse-2" wx:if="{{isPlaying}}"></view>
          <view class="play-pulse play-pulse-3" wx:if="{{isPlaying}}"></view>
        </view>

        <!-- Sound wave decoration -->
        <view class="player-wave-bars">
          <view class="pw-bar {{isPlaying ? 'animating' : ''}}" wx:for="{{20}}" wx:key="index" style="animation-delay: {{index * 0.06}}s; height: {{14 + (index % 5) * 10}}rpx;"></view>
        </view>

        <!-- Progress slider -->
        <view class="progress-section">
          <slider
            class="progress-slider"
            value="{{progress}}"
            block-size="20"
            block-color="#fff"
            activeColor="rgba(255,255,255,0.95)"
            backgroundColor="rgba(255,255,255,0.25)"
            bindchange="onSliderChange"
            bindchanging="onSliderChanging"
          />
        </view>

        <!-- Time display -->
        <view class="time-row">
          <text class="time-current">{{currentTimeText}}</text>
          <text class="time-total">{{durationText}}</text>
        </view>
      </view>
    </view>

    <!-- Info section -->
    <view class="info-card">
      <!-- Region + Featured badge row -->
      <view class="info-top-row">
        <view class="region-tag" wx:if="{{dialect.region || dialect.province}}">
          <view class="region-pin-icon"></view>
          <text>{{dialect.region || dialect.province}}</text>
        </view>
        <view class="featured-pill" wx:if="{{dialect.is_featured}}">
          <view class="star-icon"></view>
          <text>精选推荐</text>
        </view>
      </view>

      <!-- Description -->
      <view class="info-desc" wx:if="{{dialect.description}}">
        <text>{{dialect.description}}</text>
      </view>

      <!-- Tags -->
      <view class="info-tags" wx:if="{{dialect.tags && dialect.tags.length > 0}}">
        <view class="info-tag" wx:for="{{dialect.tags}}" wx:key="index" wx:for-item="tag">
          <text>#{{tag}}</text>
        </view>
      </view>

      <!-- Stats row -->
      <view class="stats-row">
        <view class="stat-block">
          <text class="stat-num">{{dialect.playCountText}}</text>
          <text class="stat-label">播放</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-block">
          <text class="stat-num">{{dialect.likeCountText}}</text>
          <text class="stat-label">点赞</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-block">
          <text class="stat-num">{{comments.length}}</text>
          <text class="stat-label">评论</text>
        </view>
      </view>
    </view>

    <!-- Collector section -->
    <view class="section-card" bindtap="goToCollectorProfile">
      <view class="section-header">
        <view class="section-title-bar"></view>
        <text class="section-title-text">采集者</text>
      </view>
      <view class="collector-row">
        <image class="collector-avatar" src="{{(dialect.collector && dialect.collector.avatar) || '/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="collector-info">
          <text class="collector-name">{{(dialect.collector && dialect.collector.nickname) || '志愿者'}}</text>
          <text class="collector-time">{{dialect.formatted_date}}</text>
        </view>
        <view class="arrow-icon">
          <view class="arrow-chevron"></view>
        </view>
      </view>
    </view>

    <!-- Missing person section -->
    <view class="section-card" wx:if="{{missingPerson}}" bindtap="goToMissingPerson">
      <view class="section-header">
        <view class="section-title-bar"></view>
        <text class="section-title-text">关联走失人员</text>
        <text class="section-link">查看详情</text>
      </view>
      <view class="missing-person-row">
        <image class="mp-photo" src="{{missingPerson.avatar || missingPerson.photo || '/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="mp-info">
          <view class="mp-name-row">
            <text class="mp-name">{{missingPerson.name || '未知'}}</text>
            <view class="mp-status-tag status-{{missingPerson.status}}">
              <text>{{missingPerson.status_text || '寻找中'}}</text>
            </view>
          </view>
          <view class="mp-detail-row">
            <text class="mp-detail" wx:if="{{missingPerson.gender}}">{{missingPerson.gender === 'male' ? '男' : missingPerson.gender === 'female' ? '女' : '未知'}}</text>
            <text class="mp-detail-sep" wx:if="{{missingPerson.gender && missingPerson.age}}">|</text>
            <text class="mp-detail" wx:if="{{missingPerson.age}}">{{missingPerson.age}}岁</text>
            <text class="mp-detail-sep" wx:if="{{missingPerson.age && missingPerson.missing_region}}">|</text>
            <text class="mp-detail" wx:if="{{missingPerson.missing_region}}">{{missingPerson.missing_region}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Comments section -->
    <view class="section-card comments-card">
      <view class="section-header">
        <view class="section-title-bar"></view>
        <text class="section-title-text">评论 ({{dialect.comment_count || comments.length}})</text>
      </view>

      <!-- Comment list -->
      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <image class="comment-avatar" src="{{(item.user && item.user.avatar) || '/images/default-avatar.png'}}" mode="aspectFill"/>
          <view class="comment-body">
            <view class="comment-top">
              <text class="comment-author">{{(item.user && item.user.nickname) || '用户'}}</text>
              <text class="comment-time">{{item.time_text}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
          </view>
        </view>
      </view>

      <!-- Empty comments -->
      <view class="empty-comments" wx:if="{{comments.length === 0}}">
        <view class="empty-chat-icon">
          <view class="chat-bubble"></view>
          <view class="chat-dots">
            <view class="cd"></view>
            <view class="cd"></view>
            <view class="cd"></view>
          </view>
        </view>
        <text class="empty-comments-text">暂无评论，来说两句吧</text>
      </view>

      <!-- Load more comments -->
      <view class="comment-load-more" wx:if="{{comments.length > 0}}">
        <text wx:if="{{commentLoading}}" class="clm-text">加载中...</text>
        <text wx:elif="{{commentNoMore}}" class="clm-text">没有更多评论了</text>
      </view>
    </view>
  </block>

  <!-- Bottom action bar -->
  <view class="bottom-bar" wx:if="{{!loading && dialect}}">
    <view class="comment-input-wrap">
      <view class="comment-input-icon"></view>
      <input
        class="comment-input"
        placeholder="写一条评论..."
        placeholder-style="color: #C0A88E;"
        value="{{commentContent}}"
        bindinput="onCommentInput"
        confirm-type="send"
        bindconfirm="submitComment"
      />
    </view>
    <view class="bar-actions">
      <view class="bar-action-btn {{isLiked ? 'liked' : ''}}" bindtap="toggleLike">
        <view class="heart-icon {{isLiked ? 'filled' : ''}}">
          <view class="heart-shape"></view>
        </view>
        <text class="bar-action-label">{{dialect.like_count > 0 ? dialect.like_count : ''}}</text>
      </view>
      <button class="bar-action-btn share-btn-reset" open-type="share">
        <view class="share-icon">
          <view class="share-arrow"></view>
          <view class="share-base"></view>
        </view>
        <text class="bar-action-label">分享</text>
      </button>
    </view>
  </view>
</view>
