<view class="page">
  <!-- Header with decorative background -->
  <view class="page-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="header-title-row">
        <view class="header-icon-wrap">
          <view class="header-sound-wave">
            <view class="hw-bar hw-bar-1"></view>
            <view class="hw-bar hw-bar-2"></view>
            <view class="hw-bar hw-bar-3"></view>
            <view class="hw-bar hw-bar-4"></view>
            <view class="hw-bar hw-bar-5"></view>
          </view>
        </view>
        <view class="header-text">
          <text class="header-title">方言录音库</text>
          <text class="header-subtitle">共收录 {{dialects.length}} 条方言</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Region filter -->
  <view class="filter-section">
    <picker mode="selector" range="{{regionOptions}}" range-key="name" value="{{selectedRegionIndex}}" bindchange="onRegionChange">
      <view class="region-picker-btn">
        <view class="region-picker-pin"></view>
        <text class="region-picker-text">{{regionOptions[selectedRegionIndex].name}}</text>
        <view class="region-picker-arrow"></view>
      </view>
    </picker>
    <view class="filter-count-badge">
      <text>{{dialects.length}} 条录音</text>
    </view>
  </view>

  <!-- Dialect list -->
  <view class="dialect-list">
    <block wx:for="{{dialects}}" wx:key="id">
      <view class="dialect-card" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- Decorative wave pattern -->
        <view class="card-wave-decoration">
          <view class="wave-line wave-line-1"></view>
          <view class="wave-line wave-line-2"></view>
          <view class="wave-line wave-line-3"></view>
        </view>

        <!-- Top row: title + featured badge -->
        <view class="card-top">
          <text class="card-title">{{item.title || '方言录音'}}</text>
          <view class="featured-badge" wx:if="{{item.is_featured}}">
            <view class="featured-star"></view>
            <text>精选</text>
          </view>
        </view>

        <!-- Description -->
        <view class="card-desc" wx:if="{{item.description}}">
          <text>{{item.description}}</text>
        </view>

        <!-- Audio player row -->
        <view class="card-player">
          <view
            class="play-btn {{playingId === item.id ? 'playing' : ''}}"
            catchtap="togglePlay"
            data-id="{{item.id}}"
            data-url="{{item.audio_url}}"
          >
            <view class="play-btn-inner">
              <view wx:if="{{playingId !== item.id}}" class="icon-play-triangle"></view>
              <view wx:else class="icon-pause-bars">
                <view class="p-bar"></view>
                <view class="p-bar"></view>
              </view>
            </view>
            <!-- Pulse rings when playing -->
            <view class="pulse-ring pulse-ring-1" wx:if="{{playingId === item.id}}"></view>
            <view class="pulse-ring pulse-ring-2" wx:if="{{playingId === item.id}}"></view>
          </view>

          <!-- Sound wave visualization -->
          <view class="card-sound-bars">
            <view class="s-bar {{playingId === item.id ? 'animating' : ''}}" wx:for="{{12}}" wx:key="barIndex" wx:for-item="barItem" wx:for-index="barIndex" style="animation-delay: {{barIndex * 0.08}}s; height: {{20 + (barIndex % 3) * 16}}rpx;"></view>
          </view>

          <view class="card-duration">
            <text>{{item.durationText}}</text>
          </view>
        </view>

        <!-- Tags -->
        <view class="card-tags" wx:if="{{item.tags && item.tags.length > 0}}">
          <view class="tag-chip" wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag">
            <text>#{{tag}}</text>
          </view>
        </view>

        <!-- Meta row: region + stats -->
        <view class="card-meta">
          <view class="meta-region">
            <view class="region-pin"></view>
            <text>{{item.region || item.province || '未知地区'}}</text>
          </view>
          <view class="meta-stats">
            <view class="stat">
              <view class="stat-icon-play"></view>
              <text>{{item.playCountText}}</text>
            </view>
            <view class="stat">
              <view class="stat-icon-heart"></view>
              <text>{{item.likeCountText}}</text>
            </view>
          </view>
        </view>

        <!-- Footer: collector info + time -->
        <view class="card-footer">
          <view class="collector">
            <image class="collector-avatar" src="{{(item.uploader && item.uploader.avatar) || (item.collector && item.collector.avatar) || '/assets/images/default-avatar.png'}}" mode="aspectFill"/>
            <text class="collector-name">{{(item.uploader && item.uploader.nickname) || (item.collector && item.collector.nickname) || '志愿者'}}</text>
          </view>
          <text class="card-time">{{item.timeAgoText}}</text>
        </view>
      </view>
    </block>

    <!-- Empty state -->
    <view class="empty-state" wx:if="{{dialects.length === 0 && !loading}}">
      <view class="empty-mic">
        <view class="empty-mic-body"></view>
        <view class="empty-mic-base"></view>
        <view class="empty-mic-stand"></view>
      </view>
      <text class="empty-title">暂无方言录音</text>
      <text class="empty-desc">点击右下角按钮，录制第一条方言</text>
    </view>

    <!-- Load more -->
    <view class="load-more" wx:if="{{dialects.length > 0}}">
      <view class="load-more-inner">
        <view class="loading-dots" wx:if="{{loading}}">
          <view class="dot dot-1"></view>
          <view class="dot dot-2"></view>
          <view class="dot dot-3"></view>
        </view>
        <text wx:elif="{{noMore}}" class="load-more-text">-- 已展示全部 --</text>
        <text wx:else class="load-more-text">上拉加载更多</text>
      </view>
    </view>
  </view>

  <!-- Floating create button -->
  <view class="fab-wrapper">
    <view class="fab {{animateCreateBtn ? 'animate' : ''}}" bindtap="goToCreate">
      <view class="fab-icon">
        <view class="fab-mic-icon"></view>
      </view>
      <text class="fab-label">录方言</text>
    </view>
  </view>
</view>
