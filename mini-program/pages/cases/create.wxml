<view class="page">
  <!-- Dynamic Title Header -->
  <view class="page-header">
    <text class="page-title">{{isEdit ? '编辑案件' : '登记走失人员'}}</text>
    <text class="page-subtitle">{{isEdit ? '修改案件信息后提交保存' : '请认真填写以下信息，帮助更多人关注'}}</text>
  </view>

  <!-- Section: Basic Info -->
  <view class="form-card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">基本信息</text>
    </view>

    <view class="field required">
      <text class="field-label">姓名</text>
      <view class="field-body">
        <input
          class="field-input"
          placeholder="请输入走失人员姓名"
          placeholder-class="field-placeholder"
          value="{{form.name}}"
          bindinput="onInput"
          data-field="name"
          maxlength="20"
        />
      </view>
    </view>

    <view class="field">
      <text class="field-label">性别</text>
      <view class="field-body">
        <picker mode="selector" range="{{genderOptions}}" range-key="label" value="0" bindchange="onGenderChange">
          <view class="picker-display">
            <text class="picker-text {{genderLabel === '请选择' ? 'placeholder-color' : ''}}">{{genderLabel}}</text>
            <text class="picker-chevron">></text>
          </view>
        </picker>
      </view>
    </view>

    <view class="field">
      <text class="field-label">年龄</text>
      <view class="field-body">
        <input
          class="field-input"
          type="digit"
          placeholder="请输入年龄"
          placeholder-class="field-placeholder"
          value="{{form.age}}"
          bindinput="onNumberInput"
          data-field="age"
          maxlength="3"
        />
      </view>
    </view>

    <view class="field">
      <text class="field-label">身高(cm)</text>
      <view class="field-body">
        <input
          class="field-input"
          type="digit"
          placeholder="请输入身高"
          placeholder-class="field-placeholder"
          value="{{form.height}}"
          bindinput="onNumberInput"
          data-field="height"
          maxlength="3"
        />
      </view>
    </view>

    <view class="field required">
      <text class="field-label">案件类型</text>
      <view class="field-body">
        <picker mode="selector" range="{{caseTypeOptions}}" range-key="label" value="0" bindchange="onCaseTypeChange">
          <view class="picker-display">
            <text class="picker-text {{caseTypeLabel === '请选择' ? 'placeholder-color' : ''}}">{{caseTypeLabel}}</text>
            <text class="picker-chevron">></text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- Section: Missing Info -->
  <view class="form-card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">走失信息</text>
    </view>

    <view class="field required">
      <text class="field-label">走失时间</text>
      <view class="field-body">
        <picker mode="date" value="{{form.missingTime}}" bindchange="onMissingTimeChange">
          <view class="picker-display">
            <text class="picker-text {{!form.missingTime ? 'placeholder-color' : ''}}">{{form.missingTime || '请选择走失时间'}}</text>
            <text class="picker-chevron">></text>
          </view>
        </picker>
      </view>
    </view>

    <view class="field required">
      <text class="field-label">走失地点</text>
      <view class="field-body field-location">
        <input
          class="field-input"
          placeholder="请输入走失地点"
          placeholder-class="field-placeholder"
          value="{{form.missingLocation}}"
          bindinput="onInput"
          data-field="missingLocation"
        />
        <view class="location-btn" bindtap="chooseLocation">
          <view class="loc-icon"></view>
          <text>地图</text>
        </view>
      </view>
    </view>

    <!-- Selected location hint -->
    <view class="location-hint" wx:if="{{form.latitude}}">
      <view class="hint-dot"></view>
      <text>已选择位置坐标</text>
    </view>

    <view class="field field-vertical">
      <text class="field-label">走失描述</text>
      <textarea
        class="field-textarea"
        placeholder="请详细描述走失经过、最后出现地点等信息"
        placeholder-class="field-placeholder"
        value="{{form.description}}"
        bindinput="onInput"
        data-field="description"
        maxlength="1000"
        show-count
      />
    </view>
  </view>

  <!-- Section: Appearance -->
  <view class="form-card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">外貌特征</text>
    </view>

    <view class="field field-vertical">
      <text class="field-label">体貌特征</text>
      <textarea
        class="field-textarea"
        placeholder="请描述脸型、发型、肤色、体型等"
        placeholder-class="field-placeholder"
        value="{{form.appearance}}"
        bindinput="onInput"
        data-field="appearance"
        maxlength="500"
      />
    </view>

    <view class="field field-vertical">
      <text class="field-label">衣着描述</text>
      <textarea
        class="field-textarea"
        placeholder="请描述走失时的穿着，包括颜色、款式等"
        placeholder-class="field-placeholder"
        value="{{form.clothing}}"
        bindinput="onInput"
        data-field="clothing"
        maxlength="500"
      />
    </view>

    <view class="field field-vertical">
      <text class="field-label">特殊特征</text>
      <textarea
        class="field-textarea"
        placeholder="如有胎记、疤痕、残疾、口音等请说明"
        placeholder-class="field-placeholder"
        value="{{form.specialFeatures}}"
        bindinput="onInput"
        data-field="specialFeatures"
        maxlength="500"
      />
    </view>
  </view>

  <!-- Section: Contact -->
  <view class="form-card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">联系人信息</text>
    </view>

    <view class="field">
      <text class="field-label">联系人</text>
      <view class="field-body">
        <input
          class="field-input"
          placeholder="请输入联系人姓名"
          placeholder-class="field-placeholder"
          value="{{form.contactName}}"
          bindinput="onInput"
          data-field="contactName"
        />
      </view>
    </view>

    <view class="field">
      <text class="field-label">关系</text>
      <view class="field-body">
        <input
          class="field-input"
          placeholder="如：父亲、母亲、儿子等"
          placeholder-class="field-placeholder"
          value="{{form.contactRelation}}"
          bindinput="onInput"
          data-field="contactRelation"
        />
      </view>
    </view>

    <view class="field required">
      <text class="field-label">联系电话</text>
      <view class="field-body">
        <input
          class="field-input"
          type="number"
          placeholder="请输入联系电话"
          placeholder-class="field-placeholder"
          value="{{form.contactPhone}}"
          bindinput="onInput"
          data-field="contactPhone"
          maxlength="11"
        />
      </view>
    </view>
  </view>

  <!-- Section: Photos -->
  <view class="form-card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">照片上传</text>
      <text class="card-count">{{photos.length}}/9</text>
    </view>

    <view class="photo-grid">
      <view class="photo-cell" wx:for="{{photos}}" wx:key="*this">
        <image class="photo-thumb" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-index="{{index}}" />
        <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">
          <text class="delete-x">x</text>
        </view>
      </view>
      <view class="photo-add" bindtap="choosePhoto" wx:if="{{photos.length < 9}}">
        <view class="add-cross">
          <view class="cross-h"></view>
          <view class="cross-v"></view>
        </view>
        <text class="add-text">添加照片</text>
      </view>
    </view>

    <view class="photo-notice">
      <view class="notice-icon"></view>
      <text class="notice-text">请上传走失人员近期清晰照片，有助于志愿者辨认</text>
    </view>
  </view>

  <!-- Submit Area -->
  <view class="submit-area">
    <button class="btn-submit" bindtap="submit" disabled="{{submitting}}">
      <text wx:if="{{!submitting}}">{{isEdit ? '保存修改' : '提交登记'}}</text>
      <view class="submit-loading" wx:else>
        <view class="mini-spinner"></view>
        <text>提交中...</text>
      </view>
    </button>
    <button class="btn-reset" bindtap="resetForm" disabled="{{submitting}}">
      <text>{{isEdit ? '还原' : '重置'}}</text>
    </button>
  </view>

  <!-- Safe Area -->
  <view class="safe-bottom"></view>
</view>
