<view class="page" wx:if="{{!loading}}">
  <!-- Hero Photo Section -->
  <view class="hero-section">
    <image
      class="hero-photo"
      src="{{caseData.photoUrl}}"
      mode="aspectFill"
      bindtap="previewImage"
      data-url="{{caseData.photoUrl}}"
    />
    <view class="hero-overlay"></view>

    <!-- Status Capsule -->
    <view class="hero-status" style="background: {{statusMap[caseData.status].color || '#999'}};">
      <text class="hero-status-text">{{(statusMap[caseData.status] && statusMap[caseData.status].label) || '未知'}}</text>
    </view>

    <!-- Name + Basic on hero -->
    <view class="hero-info">
      <view class="hero-name-row">
        <text class="hero-name">{{caseData.name}}</text>
        <text class="hero-age" wx:if="{{caseData.age}}">{{caseData.age}}岁</text>
      </view>
      <view class="hero-tags">
        <view class="hero-tag gender-tag" wx:if="{{caseData.gender}}">
          <text>{{genderMap[caseData.gender] || '未知'}}</text>
        </view>
      </view>
      <text class="hero-case-no">编号 {{caseData.case_no || caseData.id}}</text>
    </view>
  </view>

  <!-- Photo Gallery -->
  <view class="card gallery-card" wx:if="{{caseData.photos && caseData.photos.length > 1}}">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">照片集</text>
      <text class="card-count">{{caseData.photos.length}}张</text>
    </view>
    <scroll-view scroll-x class="gallery-scroll" enhanced show-scrollbar="{{false}}">
      <view class="gallery-inner">
        <image
          wx:for="{{caseData.photos}}"
          wx:key="id"
          class="gallery-item"
          src="{{item.url || item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-url="{{item.url || item}}"
        />
      </view>
    </scroll-view>
  </view>

  <!-- Basic Info Card -->
  <view class="card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">基本信息</text>
    </view>
    <view class="info-grid">
      <view class="info-cell">
        <text class="info-label">姓名</text>
        <text class="info-value">{{caseData.name}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">性别</text>
        <text class="info-value">{{genderMap[caseData.gender] || '未知'}}</text>
      </view>
      <view class="info-cell" wx:if="{{caseData.age}}">
        <text class="info-label">年龄</text>
        <text class="info-value">{{caseData.age}}岁</text>
      </view>
      <view class="info-cell" wx:if="{{caseData.height}}">
        <text class="info-label">身高</text>
        <text class="info-value">{{caseData.height}}cm</text>
      </view>
    </view>
  </view>

  <!-- Missing Info Card -->
  <view class="card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">走失信息</text>
    </view>
    <view class="info-rows">
      <view class="info-row">
        <text class="row-label">走失时间</text>
        <text class="row-value">{{caseData.missing_time}}</text>
      </view>
      <view class="info-row" bindtap="openLocation">
        <text class="row-label">走失地点</text>
        <view class="row-value row-link">
          <text>{{caseData.displayLocation || '未知'}}</text>
          <text class="link-arrow">></text>
        </view>
      </view>
    </view>
    <view class="detail-block" wx:if="{{caseData.description}}">
      <text class="detail-label">详细描述</text>
      <text class="detail-text">{{caseData.description}}</text>
    </view>
  </view>

  <!-- Appearance Card -->
  <view class="card" wx:if="{{caseData.clothes || caseData.features}}">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">外貌特征</text>
    </view>
    <view class="feature-list">
      <view class="feature-item" wx:if="{{caseData.clothes}}">
        <view class="feature-icon-wrap">
          <view class="feature-icon cloth-icon"></view>
        </view>
        <view class="feature-content">
          <text class="feature-label">衣着描述</text>
          <text class="feature-text">{{caseData.clothes}}</text>
        </view>
      </view>
      <view class="feature-item" wx:if="{{caseData.features}}">
        <view class="feature-icon-wrap">
          <view class="feature-icon special-icon"></view>
        </view>
        <view class="feature-content">
          <text class="feature-label">特殊特征</text>
          <text class="feature-text">{{caseData.features}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Contact Info Card -->
  <view class="card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">联系信息</text>
    </view>
    <view class="info-rows">
      <view class="info-row">
        <text class="row-label">联系人</text>
        <text class="row-value">{{caseData.contact_name || '未知'}} {{caseData.contact_rel ? '(' + caseData.contact_rel + ')' : ''}}</text>
      </view>
      <view class="info-row" bindtap="makePhoneCall" wx:if="{{caseData.contact_phone}}">
        <text class="row-label">联系电话</text>
        <view class="row-value row-link phone-link">
          <text>{{caseData.contact_phone}}</text>
          <text class="link-arrow">></text>
        </view>
      </view>
      <view class="info-row" wx:if="{{caseData.alt_contact}}">
        <text class="row-label">备用联系</text>
        <text class="row-value">{{caseData.alt_contact}}</text>
      </view>
    </view>
  </view>

  <!-- Track Timeline Card -->
  <view class="card">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">轨迹记录</text>
      <text class="card-action" bindtap="addTrack">+ 添加</text>
    </view>

    <view class="timeline" wx:if="{{tracks.length > 0}}">
      <view class="timeline-item" wx:for="{{tracks}}" wx:key="id">
        <!-- Left: line + dot -->
        <view class="timeline-left">
          <view class="timeline-dot {{index === 0 ? 'dot-first' : ''}}"></view>
          <view class="timeline-line" wx:if="{{index < tracks.length - 1}}"></view>
        </view>
        <!-- Right: card -->
        <view class="timeline-card">
          <view class="timeline-location">{{item.location}}</view>
          <text class="timeline-desc" wx:if="{{item.description}}">{{item.description}}</text>
          <text class="timeline-time">{{item.displayTime}} · {{(item.reporter && item.reporter.nickname) || '志愿者'}}</text>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:else>
      <view class="empty-tip-icon"></view>
      <text class="empty-tip-title">暂无轨迹记录</text>
      <text class="empty-tip-desc">发现线索请点击上方"添加"</text>
    </view>
  </view>

  <!-- Manager Operations -->
  <view class="card manager-card" wx:if="{{isManager}}">
    <view class="card-header">
      <view class="card-title-bar"></view>
      <text class="card-title">管理操作</text>
    </view>
    <view class="manager-grid">
      <view class="manager-btn" bindtap="updateStatus">
        <view class="mgr-icon mgr-status"></view>
        <text class="mgr-label">更新状态</text>
      </view>
      <view class="manager-btn" bindtap="markFound" wx:if="{{caseData.status !== 'found' && caseData.status !== 'reunited'}}">
        <view class="mgr-icon mgr-found"></view>
        <text class="mgr-label">标记找到</text>
      </view>
      <view class="manager-btn" bindtap="markReunited" wx:if="{{caseData.status !== 'reunited'}}">
        <view class="mgr-icon mgr-reunited"></view>
        <text class="mgr-label">标记团圆</text>
      </view>
      <view class="manager-btn" bindtap="createTask">
        <view class="mgr-icon mgr-task"></view>
        <text class="mgr-label">创建任务</text>
      </view>
      <view class="manager-btn" bindtap="editCase">
        <view class="mgr-icon mgr-edit"></view>
        <text class="mgr-label">编辑案件</text>
      </view>
    </view>
  </view>

  <!-- Bottom Spacer -->
  <view class="bottom-spacer"></view>

  <!-- Bottom Action Bar -->
  <view class="action-bar">
    <button class="bar-btn bar-share" open-type="share">
      <view class="bar-icon share-icon"></view>
      <text class="bar-label">分享</text>
    </button>
    <button class="bar-btn bar-phone" bindtap="makePhoneCall" wx:if="{{caseData.contact_phone}}">
      <view class="bar-icon phone-icon"></view>
      <text class="bar-label">联系家属</text>
    </button>
    <button class="bar-btn bar-primary" bindtap="addTrack">
      <view class="bar-icon track-icon"></view>
      <text class="bar-label">添加线索</text>
    </button>
  </view>
</view>

<!-- Loading State -->
<view class="loading-page" wx:if="{{loading}}">
  <view class="loading-spinner-lg"></view>
  <text class="loading-page-text">加载中...</text>
</view>
