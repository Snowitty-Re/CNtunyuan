/* ========== Page ========== */
.page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== Search Bar ========== */
.search-wrap {
  padding: 24rpx 32rpx 16rpx;
  background: linear-gradient(180deg, #FF8C42 0%, #FF8C42 60%, transparent 100%);
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 48rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.15);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 80rpx;
}

.search-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.search-btn {
  padding: 10rpx 24rpx;
  background: #FF8C42;
  border-radius: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.search-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* ========== Status Tabs ========== */
.status-tabs {
  white-space: nowrap;
  padding: 16rpx 0 20rpx;
  background: transparent;
}

.tabs-inner {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 16rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: #8C7B6B;
  background: #fff;
  border-radius: 36rpx;
  border: 2rpx solid #F0E6DB;
  transition: all 0.25s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-item.tab-active {
  background: #FF8C42;
  color: #fff;
  border-color: #FF8C42;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.3);
}

/* ========== Case List ========== */
.case-list {
  padding: 0 32rpx;
}

.case-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 109, 78, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

.case-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #FF8C42;
  border-radius: 6rpx 0 0 6rpx;
}

.case-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 12rpx rgba(139, 109, 78, 0.08);
}

/* Card Photo */
.card-photo-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.card-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #F5EDE4;
}

.card-status-dot {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

/* Card Info */
.card-info {
  flex: 1;
  min-width: 0;
}

.card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D1F10;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-status-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.card-age {
  font-size: 24rpx;
  color: #8C7B6B;
}

.card-type-tag {
  font-size: 22rpx;
  color: #FF8C42;
  background: #FFF3EA;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.location-icon {
  background: #FFD4B2;
  position: relative;
}

.location-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: #FF8C42;
  border-radius: 50%;
}

.time-icon {
  background: #D4E8FF;
  position: relative;
}

.time-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: #4A90D9;
  border-radius: 50%;
}

.meta-text {
  font-size: 24rpx;
  color: #8C7B6B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

/* Card Arrow */
.card-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-char {
  font-size: 28rpx;
  color: #D4C8BC;
  font-weight: 300;
}

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 80rpx;
}

.empty-illustration {
  margin-bottom: 40rpx;
}

.empty-circle {
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(145deg, #FFF3EA, #FFE8D6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(255, 140, 66, 0.1);
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.7;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5C4D3C;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #A89888;
}

/* ========== Loading ========== */
.load-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.loading-dots {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background: #FF8C42;
  border-radius: 50%;
  animation: dotBounce 1.4s infinite ease-in-out both;
}

.dot1 { animation-delay: -0.32s; }
.dot2 { animation-delay: -0.16s; }
.dot3 { animation-delay: 0s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.4); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.no-more-text {
  font-size: 24rpx;
  color: #C4B5A5;
  letter-spacing: 2rpx;
}

.loading-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #FFE0C4;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-label {
  font-size: 28rpx;
  color: #A89888;
}

/* ========== FAB Button ========== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 100;
}

.fab-inner {
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(145deg, #FFA564, #FF8C42);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.45),
              0 2rpx 8rpx rgba(255, 140, 66, 0.2);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fab-inner:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.35);
}

.fab-plus {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.fab-label {
  font-size: 20rpx;
  color: #FF8C42;
  margin-top: 8rpx;
  font-weight: 600;
}
