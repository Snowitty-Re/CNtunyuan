/* ========== Page ========== */
.page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: 0;
}

/* ========== Hero Section ========== */
.hero-section {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
}

.hero-photo {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 320rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(45, 31, 16, 0.85) 100%);
  pointer-events: none;
}

.hero-status {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  z-index: 2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.hero-status-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-info {
  position: absolute;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
}

.hero-name-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.hero-age {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.hero-tag {
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.hero-tag.type-tag {
  background: rgba(255, 140, 66, 0.85);
  color: #fff;
}

.hero-tag.gender-tag {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  backdrop-filter: blur(4px);
}

.hero-case-no {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}

/* ========== Cards ========== */
.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 109, 78, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-title-bar {
  width: 6rpx;
  height: 32rpx;
  background: #FF8C42;
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D1F10;
  flex: 1;
}

.card-count {
  font-size: 24rpx;
  color: #A89888;
}

.card-action {
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #FFF3EA;
  border-radius: 24rpx;
}

/* ========== Photo Gallery ========== */
.gallery-card {
  padding-bottom: 28rpx;
}

.gallery-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.gallery-inner {
  display: inline-flex;
  gap: 16rpx;
}

.gallery-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F5EDE4;
  flex-shrink: 0;
}

/* ========== Info Grid (2-col) ========== */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 2rpx;
  background: #F5EDE4;
  border-radius: 16rpx;
  overflow: hidden;
}

.info-cell {
  width: calc(50% - 1rpx);
  background: #FFFBF7;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #A89888;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D1F10;
}

/* ========== Info Rows ========== */
.info-rows {
  background: #FFFBF7;
  border-radius: 16rpx;
  padding: 4rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5EDE4;
}

.info-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #8C7B6B;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.row-value {
  font-size: 28rpx;
  color: #2D1F10;
  text-align: right;
  word-break: break-all;
  font-weight: 500;
}

.row-link {
  color: #FF8C42;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.phone-link {
  color: #4A90D9;
}

.link-arrow {
  font-size: 24rpx;
  opacity: 0.6;
}

/* ========== Detail Block ========== */
.detail-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #FFFBF7;
  border-radius: 16rpx;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #A89888;
  margin-bottom: 12rpx;
}

.detail-text {
  display: block;
  font-size: 28rpx;
  color: #2D1F10;
  line-height: 1.7;
}

/* ========== Feature List ========== */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.feature-icon-wrap {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.body-icon {
  background: linear-gradient(135deg, #FFD4B2, #FFB88C);
}

.cloth-icon {
  background: linear-gradient(135deg, #B2D4FF, #8CB8FF);
}

.special-icon {
  background: linear-gradient(135deg, #D4B2FF, #B88CFF);
}

.feature-content {
  flex: 1;
  min-width: 0;
}

.feature-label {
  display: block;
  font-size: 24rpx;
  color: #A89888;
  margin-bottom: 8rpx;
}

.feature-text {
  display: block;
  font-size: 28rpx;
  color: #2D1F10;
  line-height: 1.6;
}

/* ========== Map ========== */
.case-map {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* ========== Timeline ========== */
.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  min-height: 120rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background: #D4C8BC;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
  border: 4rpx solid #F5EDE4;
  box-sizing: border-box;
}

.timeline-dot.dot-first {
  background: #FF8C42;
  border-color: #FFE0C4;
  box-shadow: 0 0 0 4rpx rgba(255, 140, 66, 0.15);
}

.timeline-line {
  width: 3rpx;
  flex: 1;
  background: linear-gradient(180deg, #D4C8BC, #F5EDE4);
  margin: 6rpx 0;
}

.timeline-card {
  flex: 1;
  background: #FFFBF7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #F5EDE4;
}

.timeline-location {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D1F10;
  margin-bottom: 8rpx;
}

.timeline-desc {
  display: block;
  font-size: 26rpx;
  color: #5C4D3C;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.timeline-time {
  display: block;
  font-size: 22rpx;
  color: #A89888;
}

/* ========== Empty Tip ========== */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.empty-tip-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(145deg, #FFE0C4, #FFD4B2);
  border-radius: 50%;
  margin-bottom: 20rpx;
  position: relative;
}

.empty-tip-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%);
  width: 20rpx;
  height: 24rpx;
  border-bottom: 4rpx solid #FF8C42;
  border-right: 4rpx solid #FF8C42;
  border-radius: 0 0 6rpx 0;
}

.empty-tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5C4D3C;
  margin-bottom: 8rpx;
}

.empty-tip-desc {
  font-size: 24rpx;
  color: #A89888;
}

/* ========== Manager Card ========== */
.manager-card {
  border: 2rpx solid #FFF3EA;
}

.manager-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.manager-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 15rpx);
  padding: 24rpx 0;
  background: #FFFBF7;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.manager-btn:active {
  background: #FFF3EA;
  transform: scale(0.96);
}

.mgr-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.mgr-status { background: linear-gradient(135deg, #FFD4B2, #FF8C42); }
.mgr-found { background: linear-gradient(135deg, #B2FFD4, #52C41A); }
.mgr-reunited { background: linear-gradient(135deg, #FFE0C4, #FFA564); }
.mgr-task { background: linear-gradient(135deg, #B2D4FF, #4A90D9); }
.mgr-edit { background: linear-gradient(135deg, #D4B2FF, #8C5CFF); }

.mgr-label {
  font-size: 22rpx;
  color: #5C4D3C;
  font-weight: 500;
}

/* ========== Bottom Spacer ========== */
.bottom-spacer {
  height: 180rpx;
}

/* ========== Bottom Action Bar ========== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(139, 109, 78, 0.08);
  gap: 16rpx;
  z-index: 100;
}

.bar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: #F5EDE4;
  color: #5C4D3C;
}

.bar-btn::after {
  border: none;
}

.bar-btn.bar-share {
  flex: 0.8;
}

.bar-btn.bar-phone {
  background: #E8F4FF;
  color: #4A90D9;
}

.bar-btn.bar-primary {
  flex: 1.3;
  background: linear-gradient(135deg, #FFA564, #FF8C42);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255, 140, 66, 0.3);
}

.bar-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.share-icon {
  background: #C4B5A5;
  position: relative;
}

.share-icon::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #fff;
  border-right: 3rpx solid #fff;
  transform: rotate(45deg);
}

.phone-icon {
  background: #4A90D9;
  position: relative;
}

.phone-icon::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
}

.track-icon {
  background: rgba(255, 255, 255, 0.9);
  position: relative;
}

.track-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 3rpx;
  background: #FF8C42;
  box-shadow: 0 -6rpx 0 #FF8C42;
}

.bar-label {
  font-size: 26rpx;
  font-weight: 600;
}

/* ========== Loading State ========== */
.loading-page {
  min-height: 100vh;
  background: #FDF8F3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner-lg {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #FFE0C4;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-page-text {
  font-size: 28rpx;
  color: #A89888;
}
