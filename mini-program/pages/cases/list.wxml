<view class="page">
  <!-- Search Bar -->
  <view class="search-wrap">
    <view class="search-bar">
      <view class="search-icon">
        <text class="iconfont icon-search"></text>
      </view>
      <input
        class="search-input"
        type="text"
        placeholder="搜索姓名、地点..."
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="search-btn" bindtap="onSearch" wx:if="{{keyword}}">
        <text>搜索</text>
      </view>
    </view>
  </view>

  <!-- Status Tabs Horizontal Scroll -->
  <scroll-view scroll-x class="status-tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view
        class="tab-item {{currentStatus === item.value ? 'tab-active' : ''}}"
        wx:for="{{statusTabs}}"
        wx:key="value"
        bindtap="switchStatus"
        data-status="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- Case List -->
  <view class="case-list" wx:if="{{cases.length > 0}}">
    <view
      class="case-card"
      wx:for="{{cases}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <!-- Left: Photo -->
      <view class="card-photo-wrap">
        <image class="card-photo" src="{{item.photoUrl}}" mode="aspectFill" lazy-load />
        <view class="card-status-dot" style="background: {{statusMap[item.status].color || '#999'}};"></view>
      </view>

      <!-- Right: Info -->
      <view class="card-info">
        <view class="card-top-row">
          <text class="card-name">{{item.name}}</text>
          <view class="card-status-tag" style="color: {{statusMap[item.status].color || '#999'}}; background: {{statusMap[item.status].color || '#999'}}15;">
            <text>{{statusMap[item.status].label || '未知'}}</text>
          </view>
        </view>

        <view class="card-tags" wx:if="{{item.age || item.case_type}}">
          <text class="card-age" wx:if="{{item.age}}">{{item.age}}岁</text>
          <text class="card-type-tag">{{caseTypeMap[item.case_type] || '其他'}}</text>
        </view>

        <view class="card-meta">
          <view class="meta-row">
            <view class="meta-icon location-icon"></view>
            <text class="meta-text">{{item.missingLocation || '未知地点'}}</text>
          </view>
          <view class="meta-row">
            <view class="meta-icon time-icon"></view>
            <text class="meta-text">{{item.missing_time || '未知时间'}}</text>
          </view>
        </view>
      </view>

      <!-- Arrow -->
      <view class="card-arrow">
        <text class="arrow-char">></text>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{cases.length === 0 && !loading}}">
    <view class="empty-illustration">
      <view class="empty-circle">
        <text class="iconfont icon-empty empty-emoji"></text>
      </view>
    </view>
    <text class="empty-title">暂无相关案件</text>
    <text class="empty-desc">点击右下角按钮登记走失人员</text>
  </view>

  <!-- Loading / Load More -->
  <view class="load-section" wx:if="{{cases.length > 0}}">
    <view class="loading-dots" wx:if="{{loading}}">
      <view class="dot dot1"></view>
      <view class="dot dot2"></view>
      <view class="dot dot3"></view>
    </view>
    <text class="no-more-text" wx:elif="{{noMore}}">- 已经到底了 -</text>
  </view>

  <!-- Loading overlay for initial load -->
  <view class="loading-overlay" wx:if="{{loading && cases.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-label">加载中...</text>
  </view>

  <!-- FAB Create Button -->
  <view class="fab" bindtap="goToCreate">
    <view class="fab-inner">
      <text class="fab-plus">+</text>
    </view>
    <text class="fab-label">登记</text>
  </view>
</view>
