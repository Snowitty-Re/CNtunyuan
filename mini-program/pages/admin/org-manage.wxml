<view class="page">
  <view class="toolbar">
    <button class="create-btn" size="mini" bindtap="onCreateOrg">+ 新建组织</button>
  </view>

  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="top">
        <text class="name">{{item.name}}</text>
        <text class="status status-{{item.status}}">{{item.status}}</text>
      </view>
      <view class="meta">编码：{{item.code}}</view>
      <view class="meta">类型：{{item.type}} · 层级：L{{item.level}}</view>
      <view class="meta" wx:if="{{item.contact_name || item.contact_phone}}">联系人：{{item.contact_name || '--'}} {{item.contact_phone || ''}}</view>
      <view class="actions">
        <button size="mini" class="btn" data-index="{{index}}" bindtap="onOrgActions">管理</button>
      </view>
    </view>
    <empty-state show="{{!loading && list.length === 0}}" text="暂无组织数据" subText="点击右上角新建组织" />
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="nomore" wx:if="{{!loading && noMore && list.length > 0}}">没有更多了</view>
  </view>
</view>
