<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="row title-row" bindtap="goDetail" data-id="{{item.id}}">
        <text class="title">{{item.title || '未命名方言'}}</text>
        <text class="status status-{{item.status}}">{{item.status}}</text>
      </view>
      <view class="meta">地区：{{item.region || item.province || '未知'}} · 上传者：{{item.uploaderName}}</view>
      <view class="meta">创建：{{item.createdAtText}}</view>
      <view class="actions">
        <button size="mini" class="btn ghost" bindtap="goDetail" data-id="{{item.id}}">详情</button>
        <button size="mini" class="btn danger" wx:if="{{item.status !== 'inactive'}}" bindtap="updateStatus" data-id="{{item.id}}" data-status="inactive">驳回</button>
        <button size="mini" class="btn primary" wx:if="{{item.status !== 'active'}}" bindtap="updateStatus" data-id="{{item.id}}" data-status="active">通过</button>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无待处理内容</view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="nomore" wx:if="{{!loading && noMore && list.length > 0}}">没有更多了</view>
  </view>
</view>
