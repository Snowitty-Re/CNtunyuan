.page { min-height: 100vh; background: #FDF8F3; padding: 20rpx; box-sizing: border-box; padding-bottom: 140rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.field { margin-bottom: 18rpx; }
.label { display: block; color: #6E5C4B; font-size: 26rpx; margin-bottom: 8rpx; }
.required::before { content: '*'; color: #ff4d4f; margin-right: 6rpx; }
.hint { display: block; margin-top: 8rpx; font-size: 22rpx; color: #A89888; }
.input, .picker {
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 1rpx solid #EBDDCB;
  background: #FFFBF7;
  color: #2D1F10;
  font-size: 28rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 18rpx;
}
.loading { text-align: center; color: #8C7B6B; padding: 40rpx 0; }
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 20rpx 20rpx;
  box-shadow: 0 -8rpx 20rpx rgba(0,0,0,0.08);
}
.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
