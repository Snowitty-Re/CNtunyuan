<view class="page">
  <view class="toolbar">
    <button size="mini" class="pending-btn" bindtap="onTabTap" data-key="inactive">待审批</button>
    <button size="mini" class="create-btn" bindtap="onCreateUser">+ 新建用户</button>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索昵称/手机号" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <button size="mini" class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <view class="filter-row">
    <picker mode="selector" range="{{roleOptions}}" range-key="label" value="{{roleIndex}}" bindchange="onRoleChange">
      <view class="filter-picker">{{roleOptions[roleIndex].label}}</view>
    </picker>
    <picker mode="selector" range="{{orgOptions}}" range-key="name" value="{{orgIndex}}" bindchange="onOrgChange">
      <view class="filter-picker">{{orgOptions[orgIndex].name}}</view>
    </picker>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{statusFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTabTap">{{item.label}}</view>
  </view>

  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="top">
        <view>
          <text class="name">{{item.nickname || '未命名'}}</text>
          <text class="phone">{{item.phone || '--'}}</text>
        </view>
        <text class="status status-{{item.status}}">
          {{item.status === 'active' ? '正常' : (item.status === 'inactive' ? '待审批' : (item.status === 'banned' ? '封禁' : item.status))}}
        </text>
      </view>
      <view class="meta">角色：{{item.role}} · 组织：{{item.orgNameText}}</view>
      <view class="meta">邮箱：{{item.email || '--'}}</view>
      <view class="meta">创建：{{item.createdAtText}}</view>
      <view class="actions">
        <button size="mini" class="btn" bindtap="onUserActions" data-index="{{index}}">管理</button>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无用户数据</view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="nomore" wx:if="{{!loading && noMore && list.length > 0}}">没有更多了</view>
  </view>
</view>
