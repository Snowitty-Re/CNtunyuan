.page { min-height: 100vh; background: #FDF8F3; }
.tabs { display: flex; padding: 20rpx; gap: 16rpx; }
.tab-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; background: #fff; color: #8C7B6B; }
.tab-item.active { background: #FF8C42; color: #fff; font-weight: 600; }
.list { padding: 0 20rpx 24rpx; }
.batch-bar { background: #fff; border-radius: 14rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; display: flex; align-items: center; justify-content: space-between; }
.batch-left { display: flex; align-items: center; gap: 10rpx; color: #6b5f53; font-size: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.select-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; }
.select-text { color: #8C7B6B; font-size: 24rpx; }
.check { width: 30rpx; height: 30rpx; border-radius: 50%; border: 2rpx solid #d9cfc5; display: flex; align-items: center; justify-content: center; color: transparent; font-size: 20rpx; }
.check.checked { background: #FF8C42; border-color: #FF8C42; color: #fff; }
.row { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 30rpx; font-weight: 600; color: #2D1F10; max-width: 500rpx; }
.status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.status-pending { color: #D46B08; background: #FFF7E6; }
.status-active { color: #389E0D; background: #F6FFED; }
.status-inactive { color: #A8071A; background: #FFF1F0; }
.meta { font-size: 24rpx; color: #8C7B6B; margin-top: 10rpx; }
.actions { margin-top: 16rpx; display: flex; justify-content: flex-end; gap: 12rpx; }
.btn { border-radius: 10rpx; font-size: 24rpx; }
.btn.primary { background: #FF8C42; color: #fff; }
.btn.danger { background: #FF4D4F; color: #fff; }
.btn.warn { background: #FFF2E8; color: #D46B08; border: 1rpx solid #FFD8BF; }
.btn.ghost { background: #F5F5F5; color: #555; }
.btn.batch-delete { background: #FF4D4F; color: #fff; }
.btn.batch-delete[disabled] { background: #f2b7b8 !important; color: #fff !important; }
.empty, .loading, .nomore { text-align: center; color: #8C7B6B; font-size: 24rpx; padding: 24rpx 0; }
