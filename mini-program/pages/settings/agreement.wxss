.document-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 顶部 ========== */
.doc-header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 60%, #FFB085 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 48rpx;
}

.doc-icon-circle {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
}

.doc-icon-circle .iconfont {
  font-size: 42rpx;
  color: #fff;
}

.doc-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.doc-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ========== 内容区 ========== */
.doc-body {
  padding: 24rpx 32rpx;
}

.doc-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.doc-content {
  font-size: 28rpx;
  color: #4a4a4a;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
