.settings-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 顶部 ========== */
.page-header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 60%, #FFB085 100%);
}

.header-orb {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  filter: blur(40rpx);
  top: -80rpx;
  right: -60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
}

.page-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ========== 设置列表 ========== */
.settings-body {
  padding: 24rpx 32rpx 0;
}

.setting-group {
  margin-bottom: 24rpx;
}

.group-label {
  font-size: 24rpx;
  color: #b0a89e;
  font-weight: 600;
  padding: 0 8rpx 14rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.group-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f8f4f0;
  transition: all 0.15s ease;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-hover {
  background: #FFFAF5;
}

.item-icon-wrapper {
  width: 68rpx;
  height: 68rpx;
  background: linear-gradient(135deg, #FFF0E6 0%, #FFE4D0 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.item-icon-wrapper .iconfont {
  font-size: 34rpx;
  color: #FF8C42;
}

.item-title {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c2c;
  font-weight: 500;
}

.item-extra {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cache-size {
  font-size: 26rpx;
  color: #b0b0b0;
  font-weight: 500;
}

.item-arrow {
  font-size: 24rpx;
  color: #d0ccc8;
}

/* ========== 退出登录 ========== */
.logout-section {
  padding: 16rpx 32rpx 0;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 92rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #fff0f0;
  transition: all 0.2s ease;
}

.logout-btn::after {
  border: none;
}

.logout-hover {
  background: #FFF1F0;
  border-color: #ffd6d6;
}

.logout-btn .iconfont {
  font-size: 30rpx;
  color: #ff4d4f;
}

.logout-btn text {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: 500;
}

/* ========== 版本信息 ========== */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 48rpx 0 16rpx;
}

.app-name {
  font-size: 24rpx;
  color: #c9c0b8;
  font-weight: 500;
}

.version-text {
  font-size: 22rpx;
  color: #d9d1c9;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
