.about-page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: 40rpx;
}

/* ========== 品牌区 ========== */
.brand-section {
  position: relative;
  overflow: hidden;
}

.brand-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 50%, #FFB085 100%);
}

.brand-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx);
}

.brand-orb.orb-1 {
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.2);
  top: -80rpx;
  right: -60rpx;
}

.brand-orb.orb-2 {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 200, 120, 0.2);
  bottom: 20rpx;
  left: -40rpx;
}

.brand-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx 64rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.logo {
  width: 120rpx;
  height: 120rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 14rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.version-badge {
  display: inline-flex;
  padding: 6rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
}

.slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* ========== 卡片通用 ========== */
.intro-card,
.features-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FF8C42, #FFB085);
  border-radius: 4rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c2c2c;
}

.intro-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.9;
}

/* ========== 功能网格 ========== */
.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 16rpx;
  background: #FFFAF5;
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.feature-icon-circle {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FFF0E6 0%, #FFE4D0 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.feature-icon {
  font-size: 40rpx;
  color: #FF8C42;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2c;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

/* ========== 操作区 ========== */
.action-section {
  padding: 12rpx 32rpx 0;
}

.update-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.3);
}

.update-btn::after {
  border: none;
}

.update-hover {
  opacity: 0.85;
}

.update-btn .iconfont {
  font-size: 30rpx;
}

/* ========== 底部 ========== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 48rpx 0 24rpx;
}

.copyright {
  font-size: 22rpx;
  color: #c9c0b8;
}

.rights {
  font-size: 20rpx;
  color: #d9d1c9;
}
