.help-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 顶部 ========== */
.page-header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 60%, #FFB085 100%);
}

.header-orb {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  filter: blur(40rpx);
  top: -80rpx;
  right: -60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 52rpx;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ========== FAQ ========== */
.faq-section {
  padding: 24rpx 32rpx;
}

.faq-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.faq-card.expanded {
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.1);
}

.faq-question {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 16rpx;
}

.q-badge {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.question-text {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c2c;
  font-weight: 600;
}

.expand-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.expand-icon.rotated {
  transform: rotate(180deg);
}

.expand-icon .iconfont {
  font-size: 24rpx;
  color: #c9cdd4;
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}

.faq-answer.show {
  max-height: 600rpx;
}

.answer-content {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 28rpx;
  background: #FFFAF5;
}

.a-badge {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.answer-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* ========== 联系客服 ========== */
.contact-section {
  padding: 12rpx 32rpx 0;
}

.contact-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.contact-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 8rpx;
}

.contact-desc {
  font-size: 26rpx;
  color: #b0b0b0;
  margin-bottom: 28rpx;
}

.contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 320rpx;
  height: 84rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(255, 140, 66, 0.3);
}

.contact-btn::after {
  border: none;
}

.contact-hover {
  opacity: 0.85;
}

.contact-btn .iconfont {
  font-size: 28rpx;
}

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
