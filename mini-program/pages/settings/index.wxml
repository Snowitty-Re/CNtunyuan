<view class="settings-page">
  <!-- 顶部 -->
  <view class="page-header">
    <view class="header-bg">
      <view class="header-orb"></view>
    </view>
    <view class="header-content">
      <text class="page-title">设置</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="settings-body">
    <view class="setting-group" wx:for="{{settings}}" wx:key="group">
      <view class="group-label">{{item.group}}</view>
      <view class="group-card">
        <view
          class="setting-item"
          wx:for="{{item.items}}"
          wx:for-item="setting"
          wx:key="title"
          data-item="{{setting}}"
          bindtap="onSettingTap"
          hover-class="setting-hover"
        >
          <view class="item-icon-wrapper">
            <text class="iconfont icon-{{setting.icon}}"></text>
          </view>
          <text class="item-title">{{setting.title}}</text>
          <view class="item-extra">
            <text wx:if="{{setting.key === 'clearCache'}}" class="cache-size">{{cacheSize}}</text>
            <switch
              wx:if="{{setting.type === 'switch'}}"
              checked="{{setting.value}}"
              color="#FF8C42"
              data-key="{{setting.key}}"
              catchchange="onSwitchChange"
            />
            <text wx:elif="{{setting.type !== 'switch'}}" class="iconfont icon-arrow-right item-arrow"></text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout" hover-class="logout-hover">
      <text class="iconfont icon-logout"></text>
      <text>退出登录</text>
    </button>
  </view>

  <!-- 版本信息 -->
  <view class="footer-info">
    <text class="app-name">助力团圆志愿者系统</text>
    <text class="version-text">v1.0.0</text>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
