.workbench-page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 顶部欢迎区 ========== */
.header-section {
  position: relative;
  padding: 0 0 80rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 50%, #FFB085 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.gradient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
}

.orb-1 {
  width: 340rpx;
  height: 340rpx;
  background: rgba(255, 255, 255, 0.2);
  top: -120rpx;
  right: -100rpx;
}

.orb-2 {
  width: 220rpx;
  height: 220rpx;
  background: rgba(255, 200, 120, 0.25);
  bottom: 0rpx;
  left: -60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 40rpx;
}

.header-top-row {
  margin-bottom: 20rpx;
}

.date-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.date-badge .iconfont {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.date-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.greeting {
  font-weight: 400;
  opacity: 0.95;
}

.user-name {
  font-weight: 800;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

/* ========== 今日统计 ========== */
.stats-section {
  margin: -50rpx 32rpx 28rpx;
  position: relative;
  z-index: 2;
}

.stats-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 8rpx 40rpx rgba(255, 140, 66, 0.12), 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stats-card--loading {
  min-height: 150rpx;
  justify-content: center;
}

.stats-loading-text {
  font-size: 26rpx;
  color: #8f959e;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.stat-value-wrapper {
  display: flex;
  align-items: baseline;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF8C42;
  line-height: 1;
}

.stat-value.processing {
  color: #FAAD14;
}

.stat-value.completed {
  color: #52c41a;
}

.stat-label {
  font-size: 24rpx;
  color: #8f959e;
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: linear-gradient(180deg, transparent, #e8e8e8, transparent);
}

/* ========== 快捷入口 ========== */
.quick-actions-section {
  margin: 0 32rpx 28rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c2c2c;
  margin-bottom: 20rpx;
}

.quick-actions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.action-hover {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.action-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}

.action-icon-circle .iconfont {
  font-size: 40rpx;
  color: #fff;
}

.action-label {
  font-size: 24rpx;
  color: #4a4a4a;
  font-weight: 600;
}

/* ========== 最近任务 ========== */
.recent-tasks-section {
  margin: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-dot {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #FF8C42, #FFB085);
  border-radius: 4rpx;
}

.more-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: 500;
  padding: 8rpx 0;
}

.more-hover {
  opacity: 0.7;
}

.more-link .iconfont {
  font-size: 22rpx;
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-loading,
.task-error {
  background: #fff;
  border-radius: 20rpx;
  min-height: 200rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.task-loading-text {
  font-size: 26rpx;
  color: #8f959e;
}

.task-error-text {
  font-size: 26rpx;
  color: #e67e22;
}

.task-error-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #FF8C42;
  border: 2rpx solid #FF8C42;
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
}

.task-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.15s ease;
}

.task-hover {
  background: #FFFAF5;
  box-shadow: 0 4rpx 20rpx rgba(255, 140, 66, 0.1);
}

.task-priority-bar {
  width: 8rpx;
  flex-shrink: 0;
}

.task-priority-bar.priority-urgent { background: linear-gradient(180deg, #ff4d4f, #ff7875); }
.task-priority-bar.priority-high { background: linear-gradient(180deg, #FF8C42, #FFB085); }
.task-priority-bar.priority-medium { background: linear-gradient(180deg, #1890ff, #69c0ff); }
.task-priority-bar.priority-normal { background: linear-gradient(180deg, #1890ff, #69c0ff); }
.task-priority-bar.priority-low { background: linear-gradient(180deg, #52c41a, #95de64); }

.task-body {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 20rpx;
  min-width: 0;
}

.task-title-row {
  margin-bottom: 14rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.type-tag {
  color: #FF8C42;
  background: #FFF5EE;
}

.status-tag.status-assigned {
  color: #1890ff;
  background: #E6F7FF;
}
.status-tag.status-processing {
  color: #FAAD14;
  background: #FFFBE6;
}
.status-tag.status-completed {
  color: #52c41a;
  background: #F6FFED;
}
.status-tag.status-pending {
  color: #8f959e;
  background: #f5f5f5;
}
.status-tag.status-cancelled {
  color: #ff4d4f;
  background: #FFF1F0;
}

.task-time {
  font-size: 22rpx;
  color: #b0b0b0;
}

.task-action-area {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.start-btn {
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.3);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 50rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.empty-illustration {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-circle {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #FFF5EE, #FFE4D0);
  border-radius: 50%;
}

.empty-illustration .iconfont {
  position: relative;
  z-index: 1;
  font-size: 64rpx;
  color: #FFB085;
}

.empty-title {
  font-size: 30rpx;
  color: #2c2c2c;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #b0b0b0;
  margin-bottom: 28rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  border-radius: 36rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 24rpx rgba(255, 140, 66, 0.3);
}

.empty-action-hover {
  opacity: 0.85;
}

.empty-action .iconfont {
  font-size: 24rpx;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
