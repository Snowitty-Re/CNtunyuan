.edit-profile-page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: 180rpx;
}

/* ========== 头像区域 ========== */
.avatar-section {
  position: relative;
  overflow: hidden;
}

.avatar-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 50%, #FFB085 100%);
}

.avatar-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx);
}

.avatar-orb.orb-1 {
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.2);
  top: -80rpx;
  right: -60rpx;
}

.avatar-orb.orb-2 {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 200, 120, 0.25);
  bottom: -20rpx;
  left: -40rpx;
}

.avatar-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0 48rpx;
}

.avatar-wrapper {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.avatar-edit-badge {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.4);
}

.avatar-edit-badge .iconfont {
  font-size: 26rpx;
  color: #fff;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

/* ========== 表单区块 ========== */
.form-section {
  margin: 24rpx 32rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FF8C42, #FFB085);
  border-radius: 4rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c2c2c;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f8f4f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #2c2c2c;
  flex-shrink: 0;
  font-weight: 500;
}

.label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 6rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c2c;
  text-align: right;
  height: 48rpx;
  min-height: 48rpx;
}

.input-placeholder {
  color: #c9cdd4;
}

.input-group {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 验证码区域 */
.verify-item {
  background: #FFFAF5;
}

.verify-group {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.verify-input {
  flex: 1;
  font-size: 30rpx;
  color: #2c2c2c;
  text-align: right;
  height: 48rpx;
  min-height: 48rpx;
}

.verify-btn {
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  font-weight: 600;
  white-space: nowrap;
  line-height: 1.4;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.25);
}

.verify-btn::after {
  border: none;
}

.verify-btn.disabled {
  background: #d9d9d9;
  box-shadow: none;
}

/* 箭头项 */
.arrow-item {
  transition: all 0.15s ease;
}

.item-hover {
  background: #FFFAF5;
}

.arrow-right {
  display: flex;
  align-items: center;
}

.arrow-right .iconfont {
  font-size: 26rpx;
  color: #d0ccc8;
}

/* ========== 底部保存按钮 ========== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(253, 248, 243, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 20rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.3);
  letter-spacing: 2rpx;
}

.save-btn::after {
  border: none;
}

.save-btn.loading {
  opacity: 0.7;
}

.save-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.save-btn[disabled] {
  background: #d9d9d9;
  box-shadow: none;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 1000;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 640rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  transform: scale(0.88) translateY(40rpx);
  transition: all 0.35s cubic-bezier(0.32, 0.72, 0, 1);
}

.modal-overlay.show .modal-content {
  transform: scale(1) translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f2ef;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c2c2c;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

.modal-close .iconfont {
  font-size: 28rpx;
  color: #8f959e;
}

.modal-body {
  padding: 28rpx 32rpx;
}

.modal-field {
  margin-bottom: 24rpx;
}

.modal-field:last-child {
  margin-bottom: 0;
}

.modal-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #4a4a4a;
  margin-bottom: 12rpx;
}

.modal-input {
  width: 100%;
  font-size: 30rpx;
  color: #2c2c2c;
  background: #FDF8F3;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #f0ebe5;
  transition: border-color 0.2s ease;
}

.modal-input:focus {
  border-color: #FF8C42;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 32rpx;
}

.modal-cancel-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: #f5f2ef;
  color: #666;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-cancel-btn::after {
  border: none;
}

.modal-confirm-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(255, 140, 66, 0.25);
}

.modal-confirm-btn::after {
  border: none;
}

.modal-confirm-btn.loading {
  opacity: 0.7;
}

.modal-confirm-btn[disabled] {
  background: #d9d9d9;
  box-shadow: none;
}
