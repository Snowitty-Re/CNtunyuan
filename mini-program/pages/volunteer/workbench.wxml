<view class="workbench-page">
  <!-- 顶部欢迎区 -->
  <view class="header-section">
    <view class="header-bg">
      <view class="gradient-orb orb-1"></view>
      <view class="gradient-orb orb-2"></view>
    </view>
    <view class="header-content">
      <view class="header-top-row">
        <view class="date-badge">
          <text class="iconfont icon-calendar"></text>
          <text class="date-text">{{currentDate}}</text>
        </view>
      </view>
      <view class="welcome-title">
        <text class="greeting">Hi，</text>
        <text class="user-name">{{userInfo.nickname || '志愿者'}}</text>
      </view>
      <view class="welcome-subtitle">今天也要加油哦，让爱传递</view>
    </view>
  </view>

  <!-- 未绑定手机：不展示任务数据 -->
  <view class="phone-gate" wx:if="{{!phoneBound}}">
    <text class="phone-gate-title">查看任务需绑定手机号</text>
    <text class="phone-gate-desc">用于组织联络与任务通知。您可拒绝授权；拒绝后无法查看任务，其他功能可继续使用。</text>
    <button class="phone-gate-btn" bindtap="goBindPhone">去绑定手机号</button>
  </view>

  <!-- 今日统计 -->
  <view class="stats-section" wx:if="{{phoneBound}}">
    <view class="stats-card" wx:if="{{!statsLoading}}">
      <view class="stat-item">
        <view class="stat-value-wrapper">
          <text class="stat-value">{{todayStats.myPending}}</text>
        </view>
        <text class="stat-label">待处理</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value-wrapper">
          <text class="stat-value processing">{{todayStats.myProcessing}}</text>
        </view>
        <text class="stat-label">进行中</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value-wrapper">
          <text class="stat-value completed">{{todayStats.myCompleted}}</text>
        </view>
        <text class="stat-label">已完成</text>
      </view>
    </view>
    <view class="stats-card stats-card--loading" wx:else>
      <text class="stats-loading-text">统计加载中...</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions-section">
    <view class="section-label">快捷入口</view>
    <view class="quick-actions-grid">
      <view class="quick-action-item"
            wx:for="{{quickActions}}"
            wx:key="key"
            wx:if="{{item.visible !== false}}"
            bindtap="onQuickActionTap"
            data-key="{{item.key}}"
            hover-class="action-hover">
        <view class="action-icon-circle" style="background: {{item.color}};">
          <text class="iconfont icon-{{item.icon}}"></text>
        </view>
        <text class="action-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 最近任务 -->
  <view class="recent-tasks-section" wx:if="{{phoneBound}}">
    <view class="section-header">
      <view class="section-title-row">
        <view class="title-dot"></view>
        <text class="section-label">最近任务</text>
      </view>
      <view class="more-link" bindtap="goToMyTasks" hover-class="more-hover">
        <text>查看全部</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>

    <view class="task-loading" wx:if="{{tasksLoading}}">
      <text class="task-loading-text">加载任务中...</text>
    </view>

    <view class="task-error" wx:elif="{{tasksError}}">
      <text class="task-error-text">最近任务加载失败</text>
      <view class="task-error-btn" bindtap="retryRecentTasks">重试</view>
    </view>

    <!-- 任务列表 -->
    <view class="task-list" wx:elif="{{recentTasks.length > 0}}">
      <view class="task-card"
            wx:for="{{recentTasks}}"
            wx:key="id"
            bindtap="goToTaskDetail"
            data-id="{{item.id}}"
            hover-class="task-hover">
        <view class="task-priority-bar priority-{{item.priority}}"></view>
        <view class="task-body">
          <view class="task-title-row">
            <text class="task-title">{{item.title}}</text>
          </view>
          <view class="task-meta">
            <view class="meta-tag type-tag">{{taskTypeMap[item.type] || '其他'}}</view>
            <view class="meta-tag status-tag status-{{item.status}}">{{statusMap[item.status] || item.status}}</view>
            <text class="task-time">{{item.timeAgo}}</text>
          </view>
        </view>
        <view class="task-action-area" wx:if="{{item.status === 'assigned'}}" catchtap="startTask" data-id="{{item.id}}">
          <view class="start-btn">开始</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <view class="empty-illustration">
        <view class="empty-circle"></view>
        <text class="iconfont icon-empty"></text>
      </view>
      <text class="empty-title">暂无任务</text>
      <text class="empty-desc">去任务列表领取新任务吧</text>
      <view class="empty-action" bindtap="goToTaskList" hover-class="empty-action-hover">
        <text>去领取</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
