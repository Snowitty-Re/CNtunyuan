:root {
  --bg: #f7f2ea;
  --ink: #2b2b2b;
  --muted: #837b72;
  --primary: #d9652b;
  --primary-deep: #bf4f1d;
  --panel: #fffaf3;
  --line: #eadfce;
  --success: #07c160;
}

page {
  background: var(--bg);
  height: 100%;
}

.login-page {
  min-height: 100vh;
  position: relative;
  padding: 56rpx 38rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.bg-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(8rpx);
}

.orb-a {
  width: 520rpx;
  height: 520rpx;
  top: -140rpx;
  right: -140rpx;
  background: radial-gradient(circle, rgba(217, 101, 43, 0.28) 0%, rgba(217, 101, 43, 0.06) 70%, rgba(217, 101, 43, 0) 100%);
}

.orb-b {
  width: 420rpx;
  height: 420rpx;
  bottom: -120rpx;
  left: -120rpx;
  background: radial-gradient(circle, rgba(255, 181, 77, 0.22) 0%, rgba(255, 181, 77, 0.04) 72%, rgba(255, 181, 77, 0) 100%);
}

.mesh {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(191, 79, 29, 0.08);
  transform: rotate(24deg);
}

.mesh-1 {
  top: 180rpx;
  right: -240rpx;
}

.mesh-2 {
  bottom: 120rpx;
  left: -250rpx;
}

.hero {
  position: relative;
  z-index: 2;
  margin-bottom: 26rpx;
}

.hero-topline {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(191, 79, 29, 0.08);
  color: var(--primary-deep);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.logo-wrap {
  width: 126rpx;
  height: 126rpx;
  margin-top: 22rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(191, 79, 29, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 104rpx;
  height: 104rpx;
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  font-size: 56rpx;
  color: #271f16;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.panel {
  position: relative;
  z-index: 2;
  background: var(--panel);
  border: 2rpx solid var(--line);
  border-radius: 30rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(81, 56, 32, 0.08);
}

.mode-switch {
  background: #f2e8da;
  border-radius: 18rpx;
  padding: 8rpx;
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.mode-item {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f665d;
  font-size: 26rpx;
  font-weight: 600;
}

.mode-item.active {
  background: linear-gradient(140deg, var(--primary) 0%, #f08d49 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(217, 101, 43, 0.34);
}

.block {
  border-radius: 22rpx;
  padding: 20rpx;
}

.wechat-block {
  background: linear-gradient(180deg, rgba(7, 193, 96, 0.09) 0%, rgba(255, 255, 255, 0.8) 100%);
  border: 2rpx solid rgba(7, 193, 96, 0.24);
}

.phone-block {
  background: #fff;
  border: 2rpx solid #efe3d3;
}

.block-head {
  margin-bottom: 16rpx;
}

.block-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2f251b;
}

.block-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #887f75;
}

.wechat-points {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.point {
  font-size: 25rpx;
  color: #2a6d45;
}

.point::before {
  content: "• ";
}

.bind-banner {
  margin-bottom: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #fff1df;
  border: 2rpx solid #ffd0a8;
}

.bind-banner-text {
  font-size: 24rpx;
  color: #a54f1e;
}

.wechat-bind-fast {
  margin-bottom: 16rpx;
}

.wechat-bind-tip {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a8278;
}

.field {
  margin-bottom: 16rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #766d62;
}

.field-box {
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e6d9c7;
  background: #fffdf8;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.field-box:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(217, 101, 43, 0.14);
}

.prefix {
  margin-right: 14rpx;
  padding-right: 14rpx;
  border-right: 2rpx solid #ebdfcf;
  font-size: 26rpx;
  color: #9e9488;
}

.field-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.placeholder-style {
  color: #b8ab9b;
  font-size: 27rpx;
}

.code-box {
  gap: 12rpx;
}

.code-btn {
  height: 62rpx;
  line-height: 62rpx;
  min-width: 162rpx;
  padding: 0 18rpx !important;
  border-radius: 12rpx;
  border: none;
  background: #ece4da;
  color: #8d857c;
  font-size: 24rpx;
  flex-shrink: 0;
}

.code-btn::after {
  border: none;
}

.code-btn.active {
  color: #fff;
  background: linear-gradient(140deg, var(--primary) 0%, #f08d49 100%);
}

.btn {
  width: 100% !important;
  height: 88rpx;
  border-radius: 16rpx !important;
  border: none !important;
  margin: 8rpx 0 0;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}

.btn text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-wechat {
  background: linear-gradient(140deg, #07c160 0%, #07a652 100%);
  box-shadow: 0 8rpx 20rpx rgba(7, 166, 82, 0.3);
}

.btn-wechat text {
  color: #fff;
}

.btn-primary {
  background: linear-gradient(140deg, var(--primary) 0%, #ec8344 100%);
  box-shadow: 0 8rpx 20rpx rgba(217, 101, 43, 0.32);
}

.btn-primary text {
  color: #fff;
}

.actions {
  margin-top: 18rpx;
  text-align: center;
}

.action-link {
  font-size: 25rpx;
  color: var(--primary);
}

.action-divider {
  font-size: 24rpx;
  color: #c8beb1;
  margin: 0 12rpx;
}

.footer {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  text-align: center;
}

.policy-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.policy-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ccbca8;
  background: #fffdf8;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.policy-check.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.policy-check-mark {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
}

.footer-text,
.footer-link {
  font-size: 22rpx;
  line-height: 1.8;
}

.footer-text {
  color: #a89f95;
}

.footer-link {
  color: var(--primary);
}

.policy-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a89f95;
}
