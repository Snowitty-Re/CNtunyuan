/* ========================================
   登录页面 - 团圆寻亲
   色调: 暖橙 #FF8C42 / 奶油底 #FDF8F3
   ======================================== */

page {
  background-color: #FDF8F3;
  height: 100%;
}

.login-page {
  min-height: 100vh;
  background: #FDF8F3;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* ---------- 顶部装饰 ---------- */
.top-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  z-index: 0;
}

.wave {
  position: absolute;
  width: 200%;
  left: -50%;
  border-radius: 0 0 50% 50%;
}

.wave-1 {
  top: -80rpx;
  height: 400rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFA866 60%, #FFB87A 100%);
}

.wave-2 {
  top: -120rpx;
  height: 380rpx;
  background: linear-gradient(135deg, rgba(255, 140, 66, 0.25) 0%, rgba(255, 184, 122, 0.15) 100%);
}

/* ---------- 品牌区域 ---------- */
.brand-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
  margin-bottom: 60rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 140, 66, 0.3);
  margin-bottom: 28rpx;
  overflow: hidden;
}

.logo {
  width: 140rpx;
  height: 140rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 6rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

/* ---------- 登录卡片 ---------- */
.login-card {
  position: relative;
  z-index: 1;
  width: 88%;
  max-width: 650rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 60rpx rgba(255, 140, 66, 0.12), 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ---------- 登录标签切换 ---------- */
.login-tabs {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
  gap: 60rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 16rpx;
  position: relative;
}

.tab-label {
  font-size: 30rpx;
  color: #BCBCBC;
  font-weight: 500;
  transition: color 0.3s;
}

.tab-item.active .tab-label {
  color: #FF8C42;
  font-weight: 700;
  font-size: 32rpx;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #FF8C42, #FFA866);
}

/* ---------- 微信登录区域 ---------- */
.wechat-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wechat-desc {
  margin-bottom: 40rpx;
  text-align: center;
}

.wechat-desc-text {
  font-size: 26rpx;
  color: #A0A0A0;
  line-height: 1.6;
}

.wechat-login-btn {
  width: 100% !important;
  height: 100rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 50rpx !important;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  margin: 0;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.35);
  transition: opacity 0.2s;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn[disabled] {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%) !important;
  color: #fff !important;
  opacity: 0.7;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  background: rgba(255,255,255,0.3);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
}

/* ---------- 手机登录区域 ---------- */
.phone-section {
  display: flex;
  flex-direction: column;
}

/* 绑定通知 */
.binding-notice {
  display: flex;
  align-items: center;
  background: #FFF6ED;
  border: 1rpx solid #FFE0C2;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 36rpx;
}

.notice-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: #FF8C42;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 26rpx;
  color: #D4782E;
  line-height: 1.5;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.input-box {
  display: flex;
  align-items: center;
  background: #F8F5F1;
  border: 2rpx solid #F0EBE5;
  border-radius: 50rpx;
  padding: 0 30rpx;
  height: 96rpx;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.input-box:focus-within {
  border-color: #FF8C42;
  box-shadow: 0 0 0 4rpx rgba(255, 140, 66, 0.1);
}

.input-prefix {
  flex-shrink: 0;
  margin-right: 20rpx;
  padding-right: 20rpx;
  border-right: 2rpx solid #E8E2DC;
}

.field-icon {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF8C42;
}

.phone-icon {
  font-size: 28rpx;
}

.code-icon-text,
.pwd-icon-text {
  font-size: 24rpx;
  white-space: nowrap;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 96rpx;
}

.placeholder-style {
  color: #C5BEB6;
  font-size: 28rpx;
}

/* 验证码输入行 */
.code-input-box {
  padding-right: 10rpx;
}

.code-btn-wrapper {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.send-code-btn {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #C0B8AE;
  background: #EDE8E3;
  border-radius: 32rpx;
  padding: 0 24rpx !important;
  margin: 0;
  white-space: nowrap;
  border: none;
}

.send-code-btn::after {
  border: none;
}

.send-code-btn.active {
  color: #fff;
  background: linear-gradient(135deg, #FF8C42, #FFA866);
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.3);
}

.send-code-btn[disabled] {
  opacity: 0.65;
}

/* 提交按钮 */
.submit-btn {
  width: 100% !important;
  height: 100rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 50rpx !important;
  border: none !important;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff !important;
  letter-spacing: 8rpx;
  margin-top: 16rpx;
  padding: 0 !important;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.35);
  transition: opacity 0.2s;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%) !important;
  color: #fff !important;
  opacity: 0.6;
}

/* 额外链接 */
.extra-links {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
}

.extra-link {
  font-size: 26rpx;
  color: #FF8C42;
  padding: 8rpx 16rpx;
}

.link-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #DDD;
  margin: 0 8rpx;
}

/* 返回链接 */
.back-link {
  text-align: center;
  margin-top: 36rpx;
}

.back-text {
  font-size: 26rpx;
  color: #B0A89E;
  padding: 12rpx 0;
}

/* ---------- 底部协议 ---------- */
.agreement-section {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
  text-align: center;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  padding: 0 60rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: #B5AEA6;
  line-height: 1.8;
}

.agreement-link {
  font-size: 22rpx;
  color: #FF8C42;
  line-height: 1.8;
}

/* ---------- 版权 ---------- */
.copyright {
  margin-top: auto;
  padding: 40rpx 0 60rpx;
  text-align: center;
}

.copyright-text {
  font-size: 22rpx;
  color: #CBC4BC;
  letter-spacing: 2rpx;
}
