:root {
  --bg: #f8efe4;
  --ink: #2d241b;
  --muted: #806f60;
  --primary: #d9652b;
  --primary-deep: #a8471c;
  --panel: #fffaf2;
  --line: #ead8c1;
  --success: #07c160;
}

page {
  background: var(--bg);
  height: 100%;
}

.login-page {
  min-height: 100vh;
  position: relative;
  padding: 132rpx 34rpx 52rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  background:
    linear-gradient(155deg, rgba(255, 247, 234, 0.96) 0%, rgba(248, 226, 204, 0.92) 58%, rgba(255, 250, 242, 0.98) 100%);
}

@supports (padding-top: constant(safe-area-inset-top)) {
  .login-page {
    padding-top: calc(132rpx + constant(safe-area-inset-top));
  }
}

@supports (padding-top: env(safe-area-inset-top)) {
  .login-page {
    padding-top: calc(132rpx + env(safe-area-inset-top));
  }
}

.bg-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(8rpx);
}

.orb-a {
  width: 560rpx;
  height: 560rpx;
  top: -180rpx;
  right: -170rpx;
  background: radial-gradient(circle, rgba(217, 101, 43, 0.26) 0%, rgba(217, 101, 43, 0.07) 68%, rgba(217, 101, 43, 0) 100%);
}

.orb-b {
  width: 480rpx;
  height: 480rpx;
  bottom: -150rpx;
  left: -160rpx;
  background: radial-gradient(circle, rgba(255, 184, 93, 0.26) 0%, rgba(255, 184, 93, 0.05) 70%, rgba(255, 184, 93, 0) 100%);
}

.mesh {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(191, 79, 29, 0.08);
  transform: rotate(24deg);
}

.mesh-1 {
  top: 180rpx;
  right: -240rpx;
}

.mesh-2 {
  bottom: 120rpx;
  left: -250rpx;
}

.login-content {
  position: relative;
  z-index: 2;
  width: 100%;
  transform: translateY(26rpx);
}

.hero {
  position: relative;
  margin-bottom: 30rpx;
}

.brand-card {
  min-height: 178rpx;
  padding: 26rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, rgba(255, 253, 248, 0.94) 0%, rgba(255, 245, 232, 0.78) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 20rpx 50rpx rgba(128, 83, 43, 0.14);
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.hero-topline {
  display: inline-block;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 79, 29, 0.1);
  color: var(--primary-deep);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.logo-wrap {
  width: 138rpx;
  height: 138rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fff 0%, #fff3e4 100%);
  border: 2rpx solid rgba(217, 101, 43, 0.12);
  box-shadow: 0 14rpx 30rpx rgba(191, 79, 29, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 26rpx;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 50rpx;
  color: #271f16;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.1;
}

.hero-subtitle {
  display: block;
  margin-top: 18rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.panel {
  position: relative;
  background: rgba(255, 250, 242, 0.96);
  border: 2rpx solid var(--line);
  border-radius: 34rpx;
  padding: 26rpx;
  box-shadow: 0 18rpx 48rpx rgba(81, 56, 32, 0.12);
}

.mode-switch {
  background: #f1e2cf;
  border-radius: 22rpx;
  padding: 8rpx;
  display: flex;
  gap: 8rpx;
  margin-bottom: 22rpx;
}

.mode-item {
  flex: 1;
  height: 76rpx;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f665d;
  font-size: 26rpx;
  font-weight: 600;
}

.mode-item.active {
  background: linear-gradient(140deg, var(--primary) 0%, #f08d49 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(217, 101, 43, 0.34);
}

.block {
  border-radius: 26rpx;
  padding: 24rpx;
}

.wechat-block {
  background: linear-gradient(180deg, rgba(217, 101, 43, 0.09) 0%, rgba(255, 255, 255, 0.82) 100%);
  border: 2rpx solid rgba(217, 101, 43, 0.22);
}

.phone-block {
  background: #fff;
  border: 2rpx solid #efe3d3;
}

.block-head {
  margin-bottom: 16rpx;
}

.block-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2f251b;
}

.block-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #887f75;
}

.wechat-points {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.point {
  font-size: 25rpx;
  color: #7a4a2d;
}

.point::before {
  content: "• ";
}

.bind-banner {
  margin-bottom: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #fff1df;
  border: 2rpx solid #ffd0a8;
}

.bind-banner-text {
  font-size: 24rpx;
  color: #a54f1e;
}

.wechat-bind-fast {
  margin-bottom: 16rpx;
}

.btn-skip {
  margin-top: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #6b5a4a;
  border: 1rpx solid #e8d5c0;
  font-size: 28rpx;
}

.btn-skip::after,
.btn-exit::after {
  border: none;
}

.btn-exit {
  margin-top: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 14rpx;
  background: transparent;
  color: #999;
  font-size: 26rpx;
  font-weight: 400;
}

.wechat-bind-tip {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a8278;
}

.field {
  margin-bottom: 16rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #766d62;
}

.field-box {
  height: 94rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e6d9c7;
  background: #fffdf8;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.field-box:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(217, 101, 43, 0.14);
}

.prefix {
  margin-right: 14rpx;
  padding-right: 14rpx;
  border-right: 2rpx solid #ebdfcf;
  font-size: 26rpx;
  color: #9e9488;
}

.field-input {
  flex: 1;
  height: 94rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.placeholder-style {
  color: #b8ab9b;
  font-size: 27rpx;
}

.code-box {
  gap: 12rpx;
}

.code-btn {
  height: 62rpx;
  line-height: 62rpx;
  min-width: 162rpx;
  padding: 0 18rpx !important;
  border-radius: 12rpx;
  border: none;
  background: #ece4da;
  color: #8d857c;
  font-size: 24rpx;
  flex-shrink: 0;
}

.code-btn::after {
  border: none;
}

.code-btn.active {
  color: #fff;
  background: linear-gradient(140deg, var(--primary) 0%, #f08d49 100%);
}

.btn {
  width: 100% !important;
  height: 94rpx;
  border-radius: 18rpx !important;
  border: none !important;
  margin: 8rpx 0 0;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}

.btn text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-wechat {
  background: linear-gradient(140deg, var(--primary) 0%, #ec8344 100%);
  box-shadow: 0 8rpx 20rpx rgba(217, 101, 43, 0.32);
}

.btn-wechat text {
  color: #fff;
}

.btn-primary {
  background: linear-gradient(140deg, var(--primary) 0%, #ec8344 100%);
  box-shadow: 0 8rpx 20rpx rgba(217, 101, 43, 0.32);
}

.btn-primary text {
  color: #fff;
}

.actions {
  margin-top: 18rpx;
  text-align: center;
}

.action-link {
  font-size: 25rpx;
  color: var(--primary);
}

.action-divider {
  font-size: 24rpx;
  color: #c8beb1;
  margin: 0 12rpx;
}

.footer {
  position: relative;
  margin-top: 24rpx;
  text-align: center;
}

.policy-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.policy-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ccbca8;
  background: #fffdf8;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.policy-check.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.policy-check-mark {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
}

.footer-text,
.footer-link {
  font-size: 22rpx;
  line-height: 1.8;
}

.footer-text {
  color: #a89f95;
}

.footer-link {
  color: var(--primary);
}

.policy-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a89f95;
}
