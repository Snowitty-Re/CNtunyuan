<view class="login-page">
  <!-- 顶部装饰波浪 -->
  <view class="top-decoration">
    <view class="wave wave-1"></view>
    <view class="wave wave-2"></view>
  </view>

  <!-- Logo 品牌区域 -->
  <view class="brand-section">
    <view class="logo-wrapper">
      <image class="logo" src="/assets/icons/logo.png" mode="aspectFit"></image>
    </view>
    <text class="app-name">团圆寻亲</text>
    <text class="app-slogan">让爱回家，让团圆不再等待</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <!-- 登录方式切换标签 -->
    <view class="login-tabs" wx:if="{{!isBinding}}">
      <view
        class="tab-item {{loginType === 'wechat' ? 'active' : ''}}"
        data-type="wechat"
        bindtap="switchLoginType"
      >
        <text class="tab-label">微信登录</text>
        <view class="tab-indicator" wx:if="{{loginType === 'wechat'}}"></view>
      </view>
      <view
        class="tab-item {{loginType === 'phone' ? 'active' : ''}}"
        data-type="phone"
        bindtap="switchLoginType"
      >
        <text class="tab-label">手机登录</text>
        <view class="tab-indicator" wx:if="{{loginType === 'phone'}}"></view>
      </view>
    </view>

    <!-- 微信一键登录 -->
    <view class="wechat-section" wx:if="{{loginType === 'wechat' && !isBinding}}">
      <view class="wechat-desc">
        <text class="wechat-desc-text">使用微信授权快速登录，安全便捷</text>
      </view>
      <button
        class="wechat-login-btn"
        bindtap="handleWechatLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <view class="btn-content">
          <text class="wechat-icon" wx:if="{{!loading}}">微信</text>
          <text class="btn-text">微信一键登录</text>
        </view>
      </button>
    </view>

    <!-- 手机号登录 / 绑定手机号 -->
    <view class="phone-section" wx:if="{{loginType === 'phone' || isBinding}}">
      <!-- 绑定手机号提示 -->
      <view class="binding-notice" wx:if="{{isBinding}}">
        <text class="notice-icon">!</text>
        <text class="notice-text">请先绑定手机号以继续使用</text>
      </view>

      <!-- 手机号输入 -->
      <view class="form-item">
        <view class="input-box">
          <view class="input-prefix">
            <text class="field-icon phone-icon">+86</text>
          </view>
          <input
            class="field-input"
            type="number"
            placeholder="请输入手机号"
            placeholder-class="placeholder-style"
            maxlength="11"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>
      </view>

      <!-- 验证码输入（绑定时显示） -->
      <view class="form-item" wx:if="{{isBinding}}">
        <view class="input-box code-input-box">
          <view class="input-prefix">
            <text class="field-icon code-icon-text">验证码</text>
          </view>
          <input
            class="field-input"
            type="number"
            placeholder="请输入验证码"
            placeholder-class="placeholder-style"
            maxlength="6"
            value="{{smsCode}}"
            bindinput="onCodeInput"
          />
          <view class="code-btn-wrapper">
            <button
              class="send-code-btn {{canSendCode && !counting ? 'active' : ''}}"
              bindtap="sendVerifyCode"
              disabled="{{!canSendCode || counting}}"
            >
              {{counting ? countDown + 's 后重试' : '获取验证码'}}
            </button>
          </view>
        </view>
      </view>

      <!-- 密码输入（手机登录时显示） -->
      <view class="form-item" wx:if="{{!isBinding}}">
        <view class="input-box">
          <view class="input-prefix">
            <text class="field-icon pwd-icon-text">密码</text>
          </view>
          <input
            class="field-input"
            type="password"
            placeholder="请输入密码"
            placeholder-class="placeholder-style"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
        </view>
      </view>

      <!-- 登录/绑定按钮 -->
      <button
        class="submit-btn"
        bindtap="handlePhoneLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        {{isBinding ? '绑定手机号' : '登 录'}}
      </button>

      <!-- 注册 / 忘记密码 -->
      <view class="extra-links" wx:if="{{!isBinding}}">
        <text class="extra-link" bindtap="goToRegister">注册账号</text>
        <view class="link-dot"></view>
        <text class="extra-link" bindtap="goToForgot">忘记密码</text>
      </view>

      <!-- 返回微信登录 -->
      <view class="back-link" wx:if="{{isBinding}}">
        <text class="back-text" bindtap="backToWechatLogin">返回微信登录</text>
      </view>
    </view>
  </view>

  <!-- 底部用户协议 -->
  <view class="agreement-section">
    <text class="agreement-text">登录即表示您同意</text>
    <text class="agreement-link" bindtap="goToAgreement">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link" bindtap="goToPrivacy">《隐私政策》</text>
  </view>

  <!-- 底部版权 -->
  <view class="copyright">
    <text class="copyright-text">团圆寻亲志愿者系统</text>
  </view>
</view>
