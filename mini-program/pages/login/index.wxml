<view class="login-page">
  <view class="bg-layer">
    <view class="orb orb-a"></view>
    <view class="orb orb-b"></view>
    <view class="mesh mesh-1"></view>
    <view class="mesh mesh-2"></view>
  </view>

  <view class="hero">
    <view class="hero-topline">CNtunyuan Volunteer System</view>
    <view class="logo-wrap">
      <image class="logo" src="/assets/icons/logo.png" mode="aspectFit"></image>
    </view>
    <text class="hero-title">助力团圆</text>
    <text class="hero-subtitle">线索协作 · 快速联动 · 真实可追溯</text>
  </view>

  <view class="panel">
    <view class="mode-switch" wx:if="{{!isBinding}}">
      <view
        class="mode-item {{loginType === 'wechat' ? 'active' : ''}}"
        data-type="wechat"
        bindtap="switchLoginType"
      >
        <text>微信快捷登录</text>
      </view>
      <view
        class="mode-item {{loginType === 'phone' ? 'active' : ''}}"
        data-type="phone"
        bindtap="switchLoginType"
      >
        <text>手机号登录</text>
      </view>
    </view>

    <view class="block wechat-block" wx:if="{{loginType === 'wechat' && !isBinding}}">
      <view class="block-head">
        <text class="block-title">推荐方式</text>
        <text class="block-tip">授权后自动关联账号</text>
      </view>
      <view class="wechat-points">
        <text class="point">免记密码，登录更快</text>
        <text class="point">账号状态自动同步</text>
      </view>
      <button
        class="btn btn-wechat"
        bindtap="handleWechatLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <text>微信一键登录</text>
      </button>
    </view>

    <view class="block phone-block" wx:if="{{loginType === 'phone' || isBinding}}">
      <view class="block-head">
        <text class="block-title">{{isBinding ? '绑定手机号' : '手机号登录'}}</text>
        <text class="block-tip">{{isBinding ? '完成验证码校验后即可继续使用' : '请输入手机号与密码'}}</text>
      </view>

      <view class="bind-banner" wx:if="{{isBinding}}">
        <text class="bind-banner-text">当前微信账号未绑定手机号</text>
      </view>

      <view class="field">
        <text class="field-label">手机号</text>
        <view class="field-box">
          <text class="prefix">+86</text>
          <input
            class="field-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            placeholder-class="placeholder-style"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>
      </view>

      <view class="field" wx:if="{{isBinding}}">
        <text class="field-label">验证码</text>
        <view class="field-box code-box">
          <input
            class="field-input"
            type="number"
            maxlength="6"
            placeholder="请输入验证码"
            placeholder-class="placeholder-style"
            value="{{smsCode}}"
            bindinput="onCodeInput"
          />
          <button
            class="code-btn {{canSendCode && !counting ? 'active' : ''}}"
            bindtap="sendVerifyCode"
            disabled="{{!canSendCode || counting}}"
          >
            {{counting ? countDown + 's' : '获取验证码'}}
          </button>
        </view>
      </view>

      <view class="field" wx:if="{{!isBinding}}">
        <text class="field-label">登录密码</text>
        <view class="field-box">
          <input
            class="field-input"
            type="password"
            placeholder="请输入密码"
            placeholder-class="placeholder-style"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
        </view>
      </view>

      <button
        class="btn btn-primary"
        bindtap="handlePhoneLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <text>{{isBinding ? '绑定并继续' : '登录'}}</text>
      </button>

      <view class="actions" wx:if="{{!isBinding}}">
        <text class="action-link" bindtap="goToRegister">注册账号</text>
        <text class="action-divider">|</text>
        <text class="action-link" bindtap="goToForgot">忘记密码</text>
      </view>

      <view class="actions" wx:if="{{isBinding}}">
        <text class="action-link" bindtap="backToWechatLogin">返回微信登录</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">登录即表示同意</text>
    <text class="footer-link" bindtap="goToAgreement">《用户协议》</text>
    <text class="footer-text">和</text>
    <text class="footer-link" bindtap="goToPrivacy">《隐私政策》</text>
  </view>
</view>
