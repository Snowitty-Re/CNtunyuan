/* =====================================================
   首页样式 - 团圆寻亲 Production UI
   主色: --primary #FF8C42  背景: --bg #FDF8F3
   ===================================================== */

page {
  --primary: #FF8C42;
  --primary-light: #FFB085;
  --primary-bg: #FFF3EB;
  --bg: #FDF8F3;
  --green: #27AE60;
  --green-bg: #E8F8EF;
  --blue: #5B8FA8;
  --blue-bg: #E4F0F6;
  --purple: #9B7ED8;
  --purple-bg: #F0EAF8;
  --text-dark: #1A1A2E;
  --text-mid: #5A5A72;
  --text-light: #9A9AB0;
  --card-bg: #FFFFFF;
  --card-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-full: 999rpx;
}

.home-page {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 顶部问候区域 ========== */
.greeting-header {
  position: relative;
  overflow: hidden;
}

.greeting-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FFB085 50%, #FFCFA8 100%);
}

.greeting-content {
  position: relative;
  z-index: 2;
  padding: 80rpx 40rpx 60rpx;
}

.greeting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.greeting-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting-hello {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.greeting-welcome {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
  letter-spacing: 1rpx;
}

.greeting-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.logo-img {
  width: 60rpx;
  height: 60rpx;
}

/* 底部波浪 */
.greeting-wave {
  position: relative;
  z-index: 2;
  height: 40rpx;
  overflow: hidden;
}

.wave-shape {
  width: 100%;
  height: 80rpx;
  background: var(--bg);
  border-radius: 50% 50% 0 0;
  margin-top: -40rpx;
}

/* ========== 统计卡片 2x2 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-top: -8rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--card-shadow);
  transition: transform 0.15s ease;
}

.stat-card--hover {
  transform: scale(0.97);
  opacity: 0.92;
}

.stat-icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon-circle .iconfont {
  font-size: 36rpx;
}

.orange-bg {
  background: var(--primary-bg);
}
.orange-bg .iconfont { color: var(--primary); }

.green-bg {
  background: var(--green-bg);
}
.green-bg .iconfont { color: var(--green); }

.blue-bg {
  background: var(--blue-bg);
}
.blue-bg .iconfont { color: var(--blue); }

.purple-bg {
  background: var(--purple-bg);
}
.purple-bg .iconfont { color: var(--purple); }

.stat-number {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-dark);
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-light);
  font-weight: 500;
}

/* ========== 快捷操作 ========== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding: 0 24rpx;
  margin-bottom: 44rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.action-item--hover {
  opacity: 0.7;
}

.action-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.action-circle .iconfont {
  font-size: 42rpx;
  color: #FFFFFF;
}

.action-circle--orange {
  background: linear-gradient(145deg, #FF8C42, #FFB085);
}

.action-circle--green {
  background: linear-gradient(145deg, #27AE60, #6FCF97);
}

.action-circle--teal {
  background: linear-gradient(145deg, #5B8FA8, #7EB8D0);
}

.action-circle--purple {
  background: linear-gradient(145deg, #9B7ED8, #BFA8E8);
}

.action-circle--amber {
  background: linear-gradient(145deg, #E67E22, #F2A356);
}

.action-label {
  font-size: 24rpx;
  color: var(--text-mid);
  font-weight: 500;
}

/* ========== 内容区块通用 ========== */
.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-dark);
}

.section-desc {
  font-size: 22rpx;
  color: var(--text-light);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.section-more--hover {
  opacity: 0.6;
}

.section-more .iconfont {
  font-size: 20rpx;
}

/* ========== 状态提示（加载/错误/空） ========== */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #F0EAE4;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-text {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 16rpx;
}

.state-error-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FDECEA;
  color: #E74C3C;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-retry-btn {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 12rpx 36rpx;
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-full);
}

.state-retry-btn--hover {
  background: var(--primary-bg);
}

.state-empty-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-empty-icon .iconfont {
  font-size: 48rpx;
  color: var(--primary);
}

.state-action-btn {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  padding: 14rpx 40rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: var(--radius-full);
}

/* ========== 案件横向滚动 ========== */
.cases-scroll {
  width: 100%;
}

.cases-row {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
}

.case-card {
  width: 280rpx;
  flex-shrink: 0;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--card-shadow);
}

.case-card--hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.case-photo-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.case-photo {
  width: 100%;
  height: 100%;
  background: #F0EAE4;
}

/* 状态标签 */
.case-tag {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
}

.tag-missing {
  background: #FDECEA;
  color: #E74C3C;
}

.tag-searching {
  background: #FFF8E1;
  color: #F39C12;
}

.tag-found {
  background: var(--green-bg);
  color: var(--green);
}

.tag-reunited {
  background: #E8F8EF;
  color: #1E8449;
}

.tag-closed {
  background: #F0F0F0;
  color: #888888;
}

.case-body {
  padding: 18rpx 20rpx 20rpx;
}

.case-name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.case-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-dark);
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-age {
  font-size: 20rpx;
  color: var(--text-light);
  background: #F5F0EB;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.case-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.case-loc .iconfont {
  font-size: 20rpx;
  color: var(--primary);
  flex-shrink: 0;
}

.case-loc-text {
  font-size: 22rpx;
  color: var(--text-mid);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--text-light);
}

.case-time .iconfont {
  font-size: 18rpx;
}

/* ========== 方言列表 ========== */
.dialect-list {
  padding: 0 32rpx;
}

.dialect-card {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--card-shadow);
}

.dialect-card:last-child {
  margin-bottom: 0;
}

.dialect-card--hover {
  background: #FBF6F1;
}

/* 左侧播放按钮 */
.dialect-left {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.dialect-play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 140, 66, 0.35);
}

.dialect-play-btn .iconfont {
  font-size: 32rpx;
  color: #FFFFFF;
  margin-left: 4rpx;
}

/* 中间信息 */
.dialect-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dialect-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.dialect-region {
  font-size: 22rpx;
  color: var(--text-mid);
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.dialect-region .iconfont {
  font-size: 20rpx;
  color: var(--primary);
}

/* 右侧统计 */
.dialect-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  margin-left: 16rpx;
}

.dialect-meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.dialect-meta-item .iconfont {
  font-size: 20rpx;
}

/* ========== 工具类 ========== */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.safe-bottom {
  height: 40rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
