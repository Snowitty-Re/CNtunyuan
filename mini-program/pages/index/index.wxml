<view class="home-page">
  <!-- 顶部问候区域 - 渐变橙色背景 -->
  <view class="greeting-header">
    <view class="greeting-bg"></view>
    <view class="greeting-content">
      <view class="greeting-row">
        <view class="greeting-text-wrap">
          <text class="greeting-hello">{{greeting}}</text>
          <text class="greeting-welcome">欢迎使用团圆寻亲平台</text>
        </view>
        <view class="greeting-logo">
          <image src="/assets/images/logo.png" mode="aspectFit" class="logo-img" />
        </view>
      </view>
    </view>
    <view class="greeting-wave">
      <view class="wave-shape"></view>
    </view>
  </view>

  <!-- 统计数据卡片 2x2 网格 -->
  <view class="stats-grid">
    <view class="stat-card" bindtap="onStatCardTap" data-type="cases" hover-class="stat-card--hover">
      <view class="stat-icon-circle orange-bg">
        <text class="iconfont icon-people"></text>
      </view>
      <text class="stat-number">{{stats.totalCases || 0}}</text>
      <text class="stat-label">走失人员</text>
    </view>
    <view class="stat-card" bindtap="onStatCardTap" data-type="resolved" hover-class="stat-card--hover">
      <view class="stat-icon-circle green-bg">
        <text class="iconfont icon-success"></text>
      </view>
      <text class="stat-number">{{stats.resolvedCases || 0}}</text>
      <text class="stat-label">已找到</text>
    </view>
    <view class="stat-card" bindtap="onStatCardTap" data-type="volunteers" hover-class="stat-card--hover">
      <view class="stat-icon-circle blue-bg">
        <text class="iconfont icon-volunteer"></text>
      </view>
      <text class="stat-number">{{stats.volunteers || 0}}</text>
      <text class="stat-label">志愿者</text>
    </view>
    <view class="stat-card" bindtap="onStatCardTap" data-type="dialects" hover-class="stat-card--hover">
      <view class="stat-icon-circle purple-bg">
        <text class="iconfont icon-audio"></text>
      </view>
      <text class="stat-number">{{stats.dialects || 0}}</text>
      <text class="stat-label">方言录音</text>
    </view>
  </view>

  <!-- 快捷操作按钮 - 一行四个 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="onCreateCase" hover-class="action-item--hover">
      <view class="action-circle action-circle--orange">
        <text class="iconfont icon-add"></text>
      </view>
      <text class="action-label">发布案件</text>
    </view>
    <view class="action-item" bindtap="onRecordDialect" hover-class="action-item--hover">
      <view class="action-circle action-circle--green">
        <text class="iconfont icon-mic"></text>
      </view>
      <text class="action-label">录制方言</text>
    </view>
    <view class="action-item" bindtap="onViewMap" hover-class="action-item--hover">
      <view class="action-circle action-circle--teal">
        <text class="iconfont icon-location"></text>
      </view>
      <text class="action-label">查看地图</text>
    </view>
    <view class="action-item" bindtap="onMyTasks" hover-class="action-item--hover">
      <view class="action-circle action-circle--purple">
        <text class="iconfont icon-task"></text>
      </view>
      <text class="action-label">我的任务</text>
    </view>
  </view>

  <!-- 最新案件 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title-group">
        <text class="section-title">最新案件</text>
        <text class="section-desc">助力团圆，我们在行动</text>
      </view>
      <view class="section-more" bindtap="goToCases" hover-class="section-more--hover">
        <text>查看全部</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="state-box" wx:if="{{casesLoading}}">
      <view class="spinner"></view>
      <text class="state-text">正在加载...</text>
    </view>

    <!-- 错误 -->
    <view class="state-box" wx:elif="{{casesError}}">
      <view class="state-error-icon">!</view>
      <text class="state-text">加载失败，请重试</text>
      <view class="state-retry-btn" bindtap="retryLoadCases" hover-class="state-retry-btn--hover">重新加载</view>
    </view>

    <!-- 空 -->
    <view class="state-box" wx:elif="{{recentCases.length === 0}}">
      <view class="state-empty-icon">
        <text class="iconfont icon-empty"></text>
      </view>
      <text class="state-text">暂无案件信息</text>
    </view>

    <!-- 案件横向滚动卡片 -->
    <scroll-view class="cases-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:else>
      <view class="cases-row">
        <view class="case-card" wx:for="{{recentCases}}" wx:key="id" bindtap="goToCaseDetail" data-id="{{item.id}}" hover-class="case-card--hover">
          <view class="case-photo-wrap">
            <image class="case-photo" src="{{item.photoUrl}}" mode="aspectFill" lazy-load />
            <view class="case-tag tag-{{item.status}}">{{statusText[item.status] || '未知'}}</view>
          </view>
          <view class="case-body">
            <view class="case-name-row">
              <text class="case-name">{{item.name}}</text>
              <text class="case-age" wx:if="{{item.age}}">{{item.age}}岁 {{item.gender}}</text>
            </view>
            <view class="case-loc">
              <text class="iconfont icon-location"></text>
              <text class="case-loc-text">{{item.missingLocation}}</text>
            </view>
            <view class="case-time">
              <text class="iconfont icon-task"></text>
              <text>{{item.missingTime}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 方言录音 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title-group">
        <text class="section-title">方言录音</text>
        <text class="section-desc">乡音寻亲，传递希望</text>
      </view>
      <view class="section-more" bindtap="goToDialects" hover-class="section-more--hover">
        <text>查看全部</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="state-box" wx:if="{{dialectsLoading}}">
      <view class="spinner"></view>
      <text class="state-text">正在加载...</text>
    </view>

    <!-- 错误 -->
    <view class="state-box" wx:elif="{{dialectsError}}">
      <view class="state-error-icon">!</view>
      <text class="state-text">加载失败，请重试</text>
      <view class="state-retry-btn" bindtap="retryLoadDialects" hover-class="state-retry-btn--hover">重新加载</view>
    </view>

    <!-- 空 -->
    <view class="state-box" wx:elif="{{recentDialects.length === 0}}">
      <view class="state-empty-icon">
        <text class="iconfont icon-empty"></text>
      </view>
      <text class="state-text">暂无方言录音</text>
      <view class="state-action-btn" bindtap="onRecordDialect">立即录制</view>
    </view>

    <!-- 方言列表卡片 -->
    <view class="dialect-list" wx:else>
      <view class="dialect-card" wx:for="{{recentDialects}}" wx:key="id" bindtap="goToDialectDetail" data-id="{{item.id}}" hover-class="dialect-card--hover">
        <view class="dialect-left">
          <view class="dialect-play-btn">
            <text class="iconfont icon-play"></text>
          </view>
        </view>
        <view class="dialect-center">
          <text class="dialect-title text-ellipsis">{{item.title}}</text>
          <text class="dialect-region" wx:if="{{item.province || item.city}}">
            <text class="iconfont icon-location"></text>
            {{item.province}} {{item.city}}
          </text>
        </view>
        <view class="dialect-right">
          <view class="dialect-meta-item">
            <text class="iconfont icon-play"></text>
            <text>{{item.playCount}}</text>
          </view>
          <view class="dialect-meta-item">
            <text class="iconfont icon-like"></text>
            <text>{{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
