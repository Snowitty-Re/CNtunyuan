.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
}

.map {
  flex: 1;
}

.panel {
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.coord {
  margin-top: 10rpx;
  color: #666;
  font-size: 24rpx;
}

.confirm-btn {
  margin-top: 18rpx;
  background: #ff8c42 !important;
  border-radius: 12rpx;
}
