.create-task-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 加载中 ========== */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 240rpx 40rpx;
}

.loading-ring {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #F0E6DD;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #A0917F;
}

/* ========== 表单滚动区 ========== */
.form-scroll {
  height: 100vh;
}

/* ========== 页面头部 ========== */
.page-header {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 50%, #FFB085 100%);
  overflow: hidden;
}

.header-decor {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 2;
}

.page-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 2;
}

/* ========== 表单区块 ========== */
.form-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 0 28rpx 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 74, 58, 0.06);
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #FAF5F0;
}

.section-label-bar {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FF8C42, #FFB085);
  border-radius: 3rpx;
}

.section-label-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2016;
}

/* ========== 表单字段 ========== */
.field-group {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #FAF5F0;
}

.field-group:last-child {
  border-bottom: none;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.required-mark {
  color: #FF4D4F;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 4rpx;
}

.label-text {
  font-size: 28rpx;
  color: #2D2016;
  font-weight: 600;
}

.label-optional {
  font-size: 22rpx;
  color: #C4B5A5;
  margin-left: 8rpx;
  background: #FAF5F0;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

/* 输入框 */
.field-input-wrap {
  background: #FAF5F0;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.field-input-wrap:focus-within {
  border-color: #FFD4B8;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2D2016;
  box-sizing: border-box;
}

.placeholder-style {
  color: #C4B5A5;
}

/* 文本域 */
.field-textarea-wrap {
  background: #FAF5F0;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.field-textarea-wrap:focus-within {
  border-color: #FFD4B8;
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #2D2016;
  line-height: 1.7;
  box-sizing: border-box;
}

.char-counter {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #C4B5A5;
  margin-top: 12rpx;
}

/* 选择器 */
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  background: #FAF5F0;
  border-radius: 14rpx;
  padding: 0 24rpx;
}

.field-picker.picker-empty {
  color: #C4B5A5;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #C4B5A5;
}

.picker-arrow {
  font-size: 28rpx;
  color: #C4B5A5;
  font-weight: 600;
}

/* 优先级选项 */
.priority-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}

.priority-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.priority-chip-urgent { background: #FFF1F0; }
.priority-dot-urgent { background: #FF4D4F; }
.priority-chip-high { background: #FFF7E6; }
.priority-dot-high { background: #F2994A; }
.priority-chip-medium { background: #E6F4FF; }
.priority-dot-medium { background: #4A90D9; }
.priority-chip-normal { background: #E6F4FF; }
.priority-dot-normal { background: #4A90D9; }
.priority-chip-low { background: #F0F2F5; }
.priority-dot-low { background: #95A5A6; }

.priority-chip-text {
  font-size: 28rpx;
  font-weight: 600;
}

.priority-chip-urgent .priority-chip-text { color: #FF4D4F; }
.priority-chip-high .priority-chip-text { color: #F2994A; }
.priority-chip-medium .priority-chip-text { color: #4A90D9; }
.priority-chip-normal .priority-chip-text { color: #4A90D9; }
.priority-chip-low .priority-chip-text { color: #95A5A6; }

/* 日期显示 */
.date-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-icon-box {
  width: 36rpx;
  height: 36rpx;
  background: #FFE5D0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-icon-char {
  font-size: 18rpx;
  font-weight: 800;
  color: #FF8C42;
}

.date-text {
  font-size: 28rpx;
  color: #2D2016;
  font-weight: 500;
}

/* 已选案件 */
.selected-case {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.case-badge {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #FF8C42, #FFB085);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.case-badge-char {
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
}

.selected-case-name {
  font-size: 28rpx;
  color: #2D2016;
  font-weight: 500;
}

.selected-case-age {
  font-size: 24rpx;
  color: #A0917F;
}

/* 已选用户 */
.selected-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.selected-user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FFE5D0;
}

.selected-user-name {
  font-size: 28rpx;
  color: #2D2016;
  font-weight: 500;
}

/* ========== 提示信息 ========== */
.tips-box {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #FFF7F0;
  border: 1rpx solid #FFE5D0;
  border-radius: 16rpx;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}

.tip-bullet {
  width: 8rpx;
  height: 8rpx;
  background: #FF8C42;
  border-radius: 50%;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.tip-content {
  flex: 1;
  font-size: 24rpx;
  color: #8C6239;
  line-height: 1.6;
}

/* ========== 底部提交 ========== */
.submit-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(90, 74, 58, 0.08);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 44, 0.35);
}

.submit-btn::after {
  border: none;
}

.submit-btn.submitting {
  opacity: 0.85;
}

.btn-loading-ring {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
