<view class="create-task-page">
  <!-- 加载中 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 表单 -->
  <scroll-view class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:else>

    <!-- 页面头部 -->
    <view class="page-header">
      <view class="header-decor"></view>
      <text class="page-title">创建新任务</text>
      <text class="page-desc">填写任务信息，分配给合适的执行人</text>
    </view>

    <!-- 基本信息区 -->
    <view class="form-section">
      <view class="section-label">
        <view class="section-label-bar"></view>
        <text class="section-label-text">基本信息</text>
      </view>

      <!-- 任务标题 -->
      <view class="field-group">
        <view class="field-label">
          <text class="required-mark">*</text>
          <text class="label-text">任务标题</text>
        </view>
        <view class="field-input-wrap">
          <input
            class="field-input"
            placeholder="请输入任务标题"
            placeholder-class="placeholder-style"
            value="{{form.title}}"
            data-field="title"
            bindinput="onInput"
            maxlength="100"
          />
        </view>
      </view>

      <!-- 任务描述 -->
      <view class="field-group">
        <view class="field-label">
          <text class="required-mark">*</text>
          <text class="label-text">任务描述</text>
        </view>
        <view class="field-textarea-wrap">
          <textarea
            class="field-textarea"
            placeholder="请详细描述任务内容、要求等信息"
            placeholder-class="placeholder-style"
            value="{{form.description}}"
            data-field="description"
            bindinput="onInput"
            maxlength="500"
            auto-height
          />
          <text class="char-counter">{{form.description.length || 0}}/500</text>
        </view>
      </view>

      <!-- 优先级 -->
      <view class="field-group">
        <view class="field-label">
          <text class="required-mark">*</text>
          <text class="label-text">优先级</text>
        </view>
        <picker bindchange="onPriorityChange" range="{{priorities}}" range-key="label" value="{{priorityIndex}}">
          <view class="field-picker">
            <view class="priority-chip priority-chip-{{form.priority}}">
              <view class="priority-dot priority-dot-{{form.priority}}"></view>
              <text class="priority-chip-text">{{priorities[priorityIndex].label}}</text>
            </view>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <!-- 截止日期 -->
      <view class="field-group">
        <view class="field-label">
          <text class="required-mark">*</text>
          <text class="label-text">截止日期</text>
        </view>
        <picker mode="date" bindchange="onDateChange" value="{{form.deadline}}" start="{{minDate}}">
          <view class="field-picker {{form.deadline ? '' : 'picker-empty'}}">
            <view class="date-display" wx:if="{{form.deadline}}">
              <view class="date-icon-box">
                <text class="date-icon-char">D</text>
              </view>
              <text class="date-text">{{form.deadline}}</text>
            </view>
            <text class="picker-placeholder" wx:else>请选择截止日期</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 关联信息区 -->
    <view class="form-section">
      <view class="section-label">
        <view class="section-label-bar"></view>
        <text class="section-label-text">关联信息</text>
      </view>

      <!-- 关联案件 -->
      <view class="field-group">
        <view class="field-label">
          <text class="label-text">关联案件</text>
          <text class="label-optional">选填</text>
        </view>
        <picker bindchange="onCaseChange" range="{{cases}}" range-key="name" value="{{caseIndex}}">
          <view class="field-picker {{form.missing_person_id ? '' : 'picker-empty'}}">
            <block wx:if="{{form.missing_person_id}}">
              <view class="selected-case">
                <view class="case-badge">
                  <text class="case-badge-char">案</text>
                </view>
                <text class="selected-case-name">{{cases[caseIndex].name}}</text>
                <text class="selected-case-age" wx:if="{{cases[caseIndex].age}}">{{cases[caseIndex].age}}岁</text>
              </view>
            </block>
            <text class="picker-placeholder" wx:else>请选择关联案件（可选）</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <!-- 分配执行人 -->
      <view class="field-group">
        <view class="field-label">
          <text class="label-text">分配执行人</text>
          <text class="label-optional">选填</text>
        </view>
        <picker bindchange="onUserChange" range="{{users}}" range-key="nickname" value="{{userIndex}}">
          <view class="field-picker {{form.assignee_id ? '' : 'picker-empty'}}">
            <block wx:if="{{form.assignee_id}}">
              <view class="selected-user">
                <image class="selected-user-avatar" src="{{users[userIndex].avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
                <text class="selected-user-name">{{users[userIndex].nickname || users[userIndex].name}}</text>
              </view>
            </block>
            <text class="picker-placeholder" wx:else>请选择执行人（可选）</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="tips-box">
      <view class="tip-row">
        <view class="tip-bullet"></view>
        <text class="tip-content">创建任务后，被分配的执行人将收到通知</text>
      </view>
      <view class="tip-row">
        <view class="tip-bullet"></view>
        <text class="tip-content">未分配执行人的任务将显示在任务中心等待领取</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view style="height: 200rpx;"></view>
  </scroll-view>

  <!-- 底部提交按钮 -->
  <view class="submit-footer" wx:if="{{!loading}}">
    <button
      class="submit-btn {{submitting ? 'submitting' : ''}}"
      bindtap="submit"
      disabled="{{submitting}}"
    >
      <block wx:if="{{submitting}}">
        <view class="btn-loading-ring"></view>
        <text class="btn-text">创建中...</text>
      </block>
      <block wx:else>
        <text class="btn-text">创建任务</text>
      </block>
    </button>
  </view>
</view>
