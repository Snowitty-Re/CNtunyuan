.task-detail-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 加载中 ========== */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 240rpx 40rpx;
}

.loading-ring {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #F0E6DD;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #A0917F;
}

/* ========== 滚动区域 ========== */
.detail-scroll {
  height: 100vh;
}

/* ========== 状态流程条 ========== */
.status-flow-bar {
  position: relative;
  margin: 24rpx 24rpx 0;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 50%, #FFB085 100%);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 140, 66, 0.3);
  overflow: hidden;
}

.flow-bg-decor {
  position: absolute;
  top: -50rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.flow-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.flow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.flow-step.done .step-dot {
  background: rgba(255, 255, 255, 0.95);
}

.dot-fill {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: transparent;
}

.flow-step.done .dot-fill {
  background: #FF8C42;
}

.flow-step.current .step-dot {
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.2);
}

.step-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.flow-step.done .step-label {
  color: #fff;
  font-weight: 600;
}

.flow-connector {
  width: 100rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 2rpx;
  margin: 0 12rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.connector-fill {
  width: 0%;
  height: 100%;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 2rpx;
  transition: width 0.5s ease;
}

.flow-connector.done .connector-fill {
  width: 100%;
}

.cancelled-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  z-index: 3;
}

.cancelled-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* ========== 标题卡片 ========== */
.title-card {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 74, 58, 0.06);
}

.title-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title-badges {
  display: flex;
  gap: 12rpx;
}

.badge-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-pending { background: #FFF7E6; color: #F2994A; }
.badge-assigned { background: #E6F4FF; color: #4A90D9; }
.badge-processing { background: #E8F8EE; color: #27AE60; }
.badge-completed { background: #F0F2F5; color: #95A5A6; }
.badge-cancelled { background: #FFF1F0; color: #EB5757; }

.badge-priority {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-pri-urgent { background: #FFF1F0; color: #FF4D4F; }
.badge-pri-high { background: #FFF7E6; color: #F2994A; }
.badge-pri-medium { background: #E6F4FF; color: #4A90D9; }
.badge-pri-normal { background: #E6F4FF; color: #4A90D9; }
.badge-pri-low { background: #F0F2F5; color: #95A5A6; }

.overdue-flag {
  font-size: 22rpx;
  color: #FF4D4F;
  font-weight: 600;
  background: #FFF1F0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.title-text {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2D2016;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.title-time {
  font-size: 24rpx;
  color: #A0917F;
}

/* ========== 信息卡片通用 ========== */
.info-card {
  margin: 16rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 74, 58, 0.06);
}

.card-section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-blue { background: #E6F4FF; }
.icon-green { background: #E8F8EE; }
.icon-orange { background: #FFF0E5; }
.icon-purple { background: #F0E6FF; }
.icon-yellow { background: #FFF7E6; }
.icon-gray { background: #F0F2F5; }

.section-icon-char {
  font-size: 20rpx;
  font-weight: 800;
}

.icon-blue .section-icon-char { color: #4A90D9; }
.icon-green .section-icon-char { color: #27AE60; }
.icon-orange .section-icon-char { color: #FF8C42; }
.icon-purple .section-icon-char { color: #9B59B6; }
.icon-yellow .section-icon-char { color: #F2994A; }
.icon-gray .section-icon-char { color: #95A5A6; }

.section-heading {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2016;
  flex: 1;
}

/* ========== 信息行 ========== */
.info-rows {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #FAF5F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-key {
  font-size: 28rpx;
  color: #A0917F;
  flex-shrink: 0;
}

.info-val {
  font-size: 28rpx;
  color: #2D2016;
  font-weight: 500;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

.info-val.val-danger {
  color: #FF4D4F;
  font-weight: 600;
}

.info-val-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #FF8C42;
}

.link-text {
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-arrow {
  font-size: 24rpx;
  color: #FF8C42;
}

/* ========== 执行人 ========== */
.assignee-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #FAF5F0;
  border-radius: 16rpx;
}

.assignee-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(90, 74, 58, 0.1);
}

.assignee-info {
  flex: 1;
}

.assignee-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2016;
  margin-bottom: 6rpx;
}

.assignee-phone {
  font-size: 26rpx;
  color: #A0917F;
}

.assignee-arrow {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-char {
  font-size: 24rpx;
  color: #C4B5A5;
  font-weight: 600;
}

.unassigned-notice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  background: #FAF5F0;
  border-radius: 16rpx;
  justify-content: center;
}

.notice-icon-box {
  width: 40rpx;
  height: 40rpx;
  background: #FFE5D0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-icon-char {
  font-size: 24rpx;
  color: #FF8C42;
  font-weight: 700;
}

.notice-text {
  font-size: 28rpx;
  color: #A0917F;
}

/* ========== 描述 ========== */
.desc-content {
  font-size: 28rpx;
  color: #5A4A3A;
  line-height: 1.8;
  padding: 20rpx;
  background: #FAF5F0;
  border-radius: 16rpx;
  border-left: 6rpx solid #FFD4B8;
}

/* ========== 进度条 ========== */
.progress-display {
  padding: 12rpx 0;
}

.progress-track {
  height: 18rpx;
  background: #F0E6DD;
  border-radius: 9rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42, #FFB085);
  border-radius: 9rpx;
  position: relative;
  transition: width 0.5s ease;
  min-width: 18rpx;
}

.progress-glow {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
  border-radius: 0 9rpx 9rpx 0;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-percent {
  font-size: 40rpx;
  font-weight: 800;
  color: #FF8C42;
}

.progress-done-label {
  font-size: 26rpx;
  color: #27AE60;
  font-weight: 600;
  background: #E8F8EE;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* ========== 关联案件 ========== */
.case-link-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #FFF7F0;
  border: 1rpx solid #FFE5D0;
  border-radius: 16rpx;
}

.case-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #FFD4B8;
}

.case-info-col {
  flex: 1;
  min-width: 0;
}

.case-person-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2016;
  margin-bottom: 6rpx;
}

.case-detail-text {
  font-size: 24rpx;
  color: #8C6239;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-go-arrow {
  width: 48rpx;
  height: 48rpx;
  background: #FFE5D0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.case-go-arrow .arrow-char {
  color: #FF8C42;
}

/* ========== 时间线 ========== */
.timeline-card {
  padding-bottom: 20rpx;
}

.log-count {
  font-size: 22rpx;
  color: #C4B5A5;
  background: #FAF5F0;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.timeline {
  position: relative;
  padding-left: 36rpx;
}

.timeline-track {
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 3rpx;
  background: #F0E6DD;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
  position: relative;
}

.tl-dot-wrap {
  position: absolute;
  left: -36rpx;
  top: 24rpx;
}

.tl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #E0D6CC;
  border: 3rpx solid #FDF8F3;
}

.tl-dot-active {
  background: #FF8C42;
  box-shadow: 0 0 0 6rpx rgba(255, 140, 66, 0.15);
}

.tl-content {
  flex: 1;
  background: #FAF5F0;
  padding: 20rpx;
  border-radius: 14rpx;
}

.tl-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.tl-action {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2016;
}

.tl-time {
  font-size: 22rpx;
  color: #C4B5A5;
}

.tl-desc {
  display: block;
  font-size: 26rpx;
  color: #5A4A3A;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.tl-operator {
  font-size: 22rpx;
  color: #A0917F;
}

.empty-logs {
  text-align: center;
  padding: 48rpx;
}

.empty-logs-text {
  font-size: 28rpx;
  color: #C4B5A5;
}

/* ========== 底部操作栏 ========== */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(90, 74, 58, 0.08);
  z-index: 100;
}

.action-bar-inner {
  display: flex;
}

.bar-btn-group {
  display: flex;
  gap: 20rpx;
  width: 100%;
  flex-wrap: wrap;
}

.bar-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
  border: none;
}

.bar-btn::after {
  border: none;
}

.bar-btn.full-width {
  width: 100%;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 44, 0.35);
}

.btn-outline {
  background: #FAF5F0;
  color: #5A4A3A;
  border: 2rpx solid #F0E6DD;
}

.btn-success {
  background: linear-gradient(135deg, #27AE60 0%, #2ECC71 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(39, 174, 96, 0.3);
}

.btn-danger {
  background: linear-gradient(135deg, #EB5757 0%, #FF7875 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(235, 87, 87, 0.3);
}

.btn-disabled {
  background: #F0E6DD;
  color: #C4B5A5;
}

.mini-action-btn {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #FF8C42;
  background: #FFF3E9;
}

.mini-action-btn::after {
  border: none;
}

.followup-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.followup-item {
  background: #FAF5F0;
  border-radius: 14rpx;
  padding: 18rpx;
}

.followup-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.followup-author {
  font-size: 24rpx;
  color: #5A4A3A;
  font-weight: 600;
}

.followup-status {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.followup-status-pending {
  background: #FFF7E6;
  color: #F2994A;
}

.followup-status-approved {
  background: #E8F8EE;
  color: #27AE60;
}

.followup-status-rejected {
  background: #FFF1F0;
  color: #EB5757;
}

.followup-content {
  display: block;
  color: #2D2016;
  font-size: 26rpx;
  line-height: 1.55;
}

.followup-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  color: #8C7B6B;
  font-size: 22rpx;
}

.followup-attachments {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.followup-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
}

.followup-review {
  margin-top: 10rpx;
  background: #fff;
  border-radius: 10rpx;
  padding: 10rpx 12rpx;
}

.review-text {
  font-size: 22rpx;
  color: #6B5A4A;
}

.followup-actions {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
}

.followup-btn {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  background: #fff;
  color: #5A4A3A;
}

.followup-btn::after {
  border: none;
}

.followup-pass {
  background: #E8F8EE;
  color: #27AE60;
}

.followup-reject {
  background: #FFF1F0;
  color: #EB5757;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 32, 22, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 620rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 80rpx rgba(45, 32, 22, 0.2);
}

.followup-comment-modal {
  width: 680rpx;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.modal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #FAF5F0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D2016;
}

.modal-close-btn {
  width: 48rpx;
  height: 48rpx;
  background: #FAF5F0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-x {
  font-size: 28rpx;
  color: #A0917F;
  font-weight: 600;
}

.modal-body {
  padding: 40rpx 32rpx;
}

.modal-progress-val {
  display: block;
  text-align: center;
  font-size: 72rpx;
  font-weight: 800;
  color: #FF8C42;
  margin-bottom: 32rpx;
  line-height: 1;
}

.modal-progress-ring {
  display: none;
}

.modal-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #C4B5A5;
  margin-top: 24rpx;
}

.modal-actions {
  display: flex;
  padding: 0 32rpx 32rpx;
  gap: 20rpx;
}

.followup-comment-list {
  max-height: 560rpx;
  padding: 0 28rpx;
}

.followup-comment-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #FAF5F0;
}

.followup-comment-item:last-child {
  border-bottom: none;
}

.followup-comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.followup-comment-user-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.followup-comment-user {
  font-size: 24rpx;
  color: #5A4A3A;
  font-weight: 600;
}

.followup-comment-time {
  font-size: 22rpx;
  color: #A0917F;
}

.followup-comment-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.4;
}

.tag-review {
  background: #FFF1F0;
  color: #EB5757;
}

.tag-normal {
  background: #E8F8EE;
  color: #27AE60;
}

.followup-comment-content {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #2D2016;
}

.followup-comment-input-wrap {
  border-top: 1rpx solid #FAF5F0;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.followup-comment-input {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  background: #FAF5F0;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.followup-comment-submit {
  margin: 0;
  min-width: 110rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  color: #fff;
  font-size: 24rpx;
}

.followup-comment-submit::after {
  border: none;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  background: #FAF5F0;
  color: #5A4A3A;
}

.modal-btn-confirm {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 44, 0.3);
}
