<view class="feedback-page">
  <!-- 任务信息头部 -->
  <view class="task-banner" wx:if="{{task}}">
    <view class="banner-decor"></view>
    <view class="banner-content">
      <text class="banner-label">提交反馈</text>
      <text class="banner-title">{{task.title}}</text>
      <text class="banner-desc" wx:if="{{task.description}}">{{task.description}}</text>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-area">
    <!-- 反馈内容 -->
    <view class="form-card">
      <view class="form-card-header">
        <view class="form-icon-box icon-orange">
          <text class="form-icon-char">F</text>
        </view>
        <text class="form-card-title">反馈内容</text>
        <text class="form-required-tag">必填</text>
      </view>
      <view class="textarea-container">
        <textarea
          class="form-textarea"
          placeholder="请详细描述任务执行情况、遇到的问题和解决方案..."
          placeholder-class="placeholder-style"
          maxlength="500"
          value="{{feedback}}"
          bindinput="onFeedbackInput"
          auto-height
        />
        <view class="textarea-footer">
          <view class="char-progress">
            <view class="char-progress-fill" style="width: {{(feedback.length || 0) / 5}}%"></view>
          </view>
          <text class="char-count">{{feedback.length || 0}}/500</text>
        </view>
      </view>
    </view>

    <!-- 任务结果 -->
    <view class="form-card">
      <view class="form-card-header">
        <view class="form-icon-box icon-green">
          <text class="form-icon-char">R</text>
        </view>
        <text class="form-card-title">任务结果</text>
        <text class="form-optional-tag">选填</text>
      </view>
      <view class="textarea-container">
        <textarea
          class="form-textarea form-textarea-short"
          placeholder="请简要说明任务最终结果..."
          placeholder-class="placeholder-style"
          maxlength="200"
          value="{{result}}"
          bindinput="onResultInput"
          auto-height
        />
      </view>
    </view>

    <!-- 上传图片 -->
    <view class="form-card">
      <view class="form-card-header">
        <view class="form-icon-box icon-blue">
          <text class="form-icon-char">P</text>
        </view>
        <text class="form-card-title">上传图片</text>
        <text class="form-optional-tag">选填</text>
      </view>
      <view class="photo-grid">
        <view
          class="photo-item"
          wx:for="{{photos}}"
          wx:key="index"
        >
          <image
            class="photo-img"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            bindtap="previewImage"
          />
          <view
            class="photo-delete"
            data-index="{{index}}"
            catchtap="deleteImage"
          >
            <text class="delete-char">x</text>
          </view>
        </view>

        <view class="photo-add" bindtap="chooseImage" wx:if="{{photos.length < 9}}">
          <view class="add-icon-wrap">
            <text class="add-icon-char">+</text>
          </view>
          <text class="add-count">{{photos.length}}/9</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button
      class="submit-btn {{loading ? 'btn-loading' : ''}}"
      bindtap="submitFeedback"
      disabled="{{loading}}"
    >
      <view class="btn-loading-ring" wx:if="{{loading}}"></view>
      <text class="btn-label">{{loading ? '提交中...' : '提交反馈'}}</text>
    </button>
  </view>
</view>
