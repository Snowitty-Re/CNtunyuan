<view class="tasks-page">
  <!-- 顶部统计卡片 -->
  <view class="stats-banner">
    <view class="stats-bg-decor"></view>
    <view class="stats-bg-decor-2"></view>
    <view class="stats-header">
      <text class="stats-title">任务中心</text>
      <text class="stats-subtitle">实时任务数据总览</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card" bindtap="filterByStatus" data-status="">
        <view class="stat-card-inner">
          <text class="stat-number">{{stats.total || 0}}</text>
          <text class="stat-name">全部任务</text>
        </view>
        <view class="stat-icon-bg">
          <text class="stat-icon-text">ALL</text>
        </view>
      </view>
      <view class="stat-card stat-pending" bindtap="filterByStatus" data-status="pending">
        <view class="stat-card-inner">
          <text class="stat-number">{{stats.pending || 0}}</text>
          <text class="stat-name">待分配</text>
        </view>
        <view class="stat-pulse pending" wx:if="{{stats.pending > 0}}"></view>
      </view>
      <view class="stat-card stat-processing" bindtap="filterByStatus" data-status="processing">
        <view class="stat-card-inner">
          <text class="stat-number">{{stats.processing || 0}}</text>
          <text class="stat-name">进行中</text>
        </view>
      </view>
      <view class="stat-card stat-completed" bindtap="filterByStatus" data-status="completed">
        <view class="stat-card-inner">
          <text class="stat-number">{{stats.completed || 0}}</text>
          <text class="stat-name">已完成</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 状态筛选标签 -->
  <view class="filter-bar">
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-list">
        <view class="filter-chip {{currentStatus === '' ? 'active' : ''}}" bindtap="filterByStatus" data-status="">
          <text class="chip-text">全部</text>
        </view>
        <view class="filter-chip {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="filterByStatus" data-status="pending">
          <view class="chip-dot pending"></view>
          <text class="chip-text">待分配</text>
        </view>
        <view class="filter-chip {{currentStatus === 'processing' ? 'active' : ''}}" bindtap="filterByStatus" data-status="processing">
          <view class="chip-dot processing"></view>
          <text class="chip-text">进行中</text>
        </view>
        <view class="filter-chip {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="filterByStatus" data-status="completed">
          <view class="chip-dot completed"></view>
          <text class="chip-text">已完成</text>
        </view>
        <view class="filter-chip {{currentStatus === 'cancelled' ? 'active' : ''}}" bindtap="filterByStatus" data-status="cancelled">
          <view class="chip-dot cancelled"></view>
          <text class="chip-text">已取消</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="initial-state initial-state--loading" wx:if="{{loading && tasks.length === 0}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
    <text class="initial-state-title">正在加载任务</text>
    <text class="initial-state-desc">请稍候...</text>
  </view>

  <view class="initial-state initial-state--error" wx:elif="{{loadError && tasks.length === 0}}">
    <view class="initial-error-icon">!</view>
    <text class="initial-state-title">任务加载失败</text>
    <text class="initial-state-desc">{{errorMessage || '请检查网络后重试'}}</text>
    <view class="initial-retry-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <!-- 任务列表 -->
  <scroll-view
    class="task-list"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
    enhanced
    show-scrollbar="{{false}}"
    wx:else
  >
    <view class="task-cards">
      <view class="task-card" wx:for="{{tasks}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- 左侧优先级装饰条 -->
        <view class="card-priority-bar priority-bar-{{item.priority}}"></view>

        <view class="card-body">
          <!-- 头部：状态 + 优先级 -->
          <view class="card-top-row">
            <view class="status-badge status-{{item.status}}">
              <view class="status-indicator"></view>
              <text class="status-label">{{statusMap[item.status] || item.status}}</text>
            </view>
            <view class="priority-pill priority-{{item.priority}}">
              {{priorityMap[item.priority]}}
            </view>
          </view>

          <!-- 标题 -->
          <text class="card-title">{{item.title}}</text>

          <!-- 描述 -->
          <text class="card-desc" wx:if="{{item.description}}">{{item.description}}</text>

          <!-- 关联案件 -->
          <view class="card-case-link" wx:if="{{item.missing_person}}">
            <view class="case-icon-wrap">
              <text class="case-icon-char">案</text>
            </view>
            <text class="case-link-text">关联：{{item.missing_person.name}}</text>
          </view>

          <!-- 底部元信息 -->
          <view class="card-footer-row">
            <view class="meta-chip {{item.isOverdue ? 'overdue' : ''}}" wx:if="{{item.deadline}}">
              <text class="meta-icon-char">T</text>
              <text class="meta-label">截止 {{item.deadline}}</text>
            </view>
            <view class="meta-chip" wx:if="{{item.assignee}}">
              <text class="meta-icon-char">U</text>
              <text class="meta-label">{{item.assignee.nickname || item.assignee.name}}</text>
            </view>
          </view>
        </view>

        <!-- 快速领取 -->
        <view class="card-claim-action" wx:if="{{item.status === 'pending' && canCreate}}" catchtap="quickClaim" data-id="{{item.id}}">
          <view class="claim-btn">
            <text class="claim-btn-text">+</text>
          </view>
          <text class="claim-label">领取</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && tasks.length === 0}}">
      <view class="empty-visual">
        <view class="empty-circle empty-circle-outer"></view>
        <view class="empty-circle empty-circle-inner"></view>
        <view class="empty-icon-box">
          <text class="empty-icon-char">!</text>
        </view>
      </view>
      <text class="empty-heading">暂无任务</text>
      <text class="empty-subtext">暂时没有符合条件的任务</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
    <view class="no-more" wx:if="{{!hasMore && tasks.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">已经到底啦</text>
      <view class="no-more-line"></view>
    </view>
  </scroll-view>

  <!-- 创建任务浮动按钮 -->
  <view class="fab" bindtap="goToCreate" wx:if="{{canCreate}}">
    <view class="fab-btn">
      <text class="fab-icon">+</text>
    </view>
    <view class="fab-shadow"></view>
  </view>
</view>
