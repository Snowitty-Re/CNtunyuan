.my-tasks-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 标签栏 ========== */
.tab-strip {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 0 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(90, 74, 58, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 0 24rpx;
  font-size: 28rpx;
  color: #8C7B6B;
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: #FF8C42;
  font-weight: 600;
}

.tab-label {
  font-size: 28rpx;
}

.tab-badge {
  background: linear-gradient(135deg, #FF8C42, #FF6B2C);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  min-width: 28rpx;
  text-align: center;
}

.badge-num {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8C42, #FFB085);
  border-radius: 3rpx;
}

/* ========== 任务列表 ========== */
.task-list {
  height: calc(100vh - 96rpx);
  padding: 20rpx 24rpx;
}

.task-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.task-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(90, 74, 58, 0.06);
  overflow: hidden;
}

.card-main {
  padding: 24rpx 28rpx;
}

/* 头部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
  gap: 16rpx;
}

.card-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2016;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.status-dot-mini {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.status-text-mini {
  font-size: 22rpx;
  font-weight: 500;
}

.status-pending { background: #FFF7E6; }
.status-pending .status-dot-mini { background: #F2994A; }
.status-pending .status-text-mini { color: #F2994A; }

.status-assigned { background: #E6F4FF; }
.status-assigned .status-dot-mini { background: #4A90D9; }
.status-assigned .status-text-mini { color: #4A90D9; }

.status-processing { background: #E8F8EE; }
.status-processing .status-dot-mini { background: #27AE60; animation: blink 2s infinite; }
.status-processing .status-text-mini { color: #27AE60; }

.status-completed { background: #F0F2F5; }
.status-completed .status-dot-mini { background: #95A5A6; }
.status-completed .status-text-mini { color: #95A5A6; }

.status-cancelled { background: #FFF1F0; }
.status-cancelled .status-dot-mini { background: #EB5757; }
.status-cancelled .status-text-mini { color: #EB5757; }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* 标签行 */
.card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.priority-tag {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.priority-urgent { background: #FFF1F0; color: #FF4D4F; }
.priority-high { background: #FFF7E6; color: #F2994A; }
.priority-medium { background: #E6F4FF; color: #4A90D9; }
.priority-normal { background: #E6F4FF; color: #4A90D9; }
.priority-low { background: #F0F2F5; color: #95A5A6; }

.deadline-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #A0917F;
}

.dl-icon {
  width: 24rpx;
  height: 24rpx;
  background: #F0E6DD;
  border-radius: 4rpx;
  font-size: 14rpx;
  font-weight: 800;
  color: #A0917F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dl-text {
  font-size: 22rpx;
}

.deadline-tag.overdue {
  color: #FF4D4F;
}

.deadline-tag.overdue .dl-icon {
  background: #FFF1F0;
  color: #FF4D4F;
}

/* 描述 */
.card-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  color: #8C7B6B;
  line-height: 1.55;
  margin-bottom: 14rpx;
}

/* 关联案件 */
.card-case {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  background: #FFF7F0;
  border: 1rpx solid #FFE5D0;
  border-radius: 8rpx;
  margin-bottom: 14rpx;
}

.case-icon-mini {
  width: 28rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #FF8C42, #FFB085);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.case-char {
  font-size: 14rpx;
  color: #fff;
  font-weight: 700;
}

.case-name-text {
  font-size: 24rpx;
  color: #8C6239;
}

/* 进度条 */
.card-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  background: #F0E6DD;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42, #FFB085);
  border-radius: 6rpx;
  position: relative;
  transition: width 0.4s ease;
  min-width: 12rpx;
}

.progress-shine {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 24rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35));
  border-radius: 0 6rpx 6rpx 0;
}

.progress-num {
  font-size: 24rpx;
  color: #FF8C42;
  font-weight: 700;
  min-width: 60rpx;
  text-align: right;
}

/* ========== 操作按钮 ========== */
.card-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 24rpx;
  border-top: 1rpx solid #FAF5F0;
  padding-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
  border: none;
}

.action-btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 44, 0.3);
}

.btn-outline {
  background: #FAF5F0;
  color: #5A4A3A;
  border: 2rpx solid #F0E6DD;
}

.btn-success {
  background: linear-gradient(135deg, #27AE60 0%, #2ECC71 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(39, 174, 96, 0.25);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-visual {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 36rpx;
}

.empty-bg-circle {
  position: absolute;
  top: 0;
  left: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0E5, #FFE0CC);
}

.empty-icon-box {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2C);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 44, 0.3);
}

.empty-icon-char {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
}

.empty-heading {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2016;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #A0917F;
  text-align: center;
}

/* ========== 加载更多 ========== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx;
}

.loading-ring-small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #F0E6DD;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-more-text {
  font-size: 24rpx;
  color: #A0917F;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx 60rpx;
}

.no-more-text {
  font-size: 22rpx;
  color: #C4B5A5;
  flex-shrink: 0;
}

.no-more-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #E8DDD2, transparent);
  max-width: 140rpx;
}
