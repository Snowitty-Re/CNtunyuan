.followup-detail-page {
  min-height: 100vh;
  background: #FDF8F3;
}

.loading-wrap {
  padding: 180rpx 0;
  text-align: center;
}

.loading-text {
  color: #A0917F;
  font-size: 28rpx;
}

.scroll {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 74, 58, 0.06);
  margin-bottom: 16rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 32rpx;
  color: #2D2016;
  font-weight: 700;
}

.status {
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-pending {
  background: #FFF7E6;
  color: #F2994A;
}

.status-approved {
  background: #E8F8EE;
  color: #27AE60;
}

.status-rejected {
  background: #FFF1F0;
  color: #EB5757;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 24rpx;
  color: #8C7B6B;
}

.content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #2D2016;
  background: #FAF5F0;
  border-radius: 12rpx;
  padding: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #2D2016;
  font-weight: 600;
}

.attachments {
  margin-top: 16rpx;
}

.attachment-list {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.attachment-item {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.review-remark {
  margin-top: 10rpx;
  background: #FAF5F0;
  border-radius: 10rpx;
  padding: 12rpx;
  font-size: 24rpx;
  color: #5A4A3A;
}

.review-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.review-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.review-btn::after {
  border: none;
}

.pass {
  background: #E8F8EE;
  color: #27AE60;
}

.reject {
  background: #FFF1F0;
  color: #EB5757;
}

.comment-list {
  margin-top: 14rpx;
}

.comment-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #FAF5F0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-user-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.comment-user {
  font-size: 24rpx;
  color: #5A4A3A;
  font-weight: 600;
}

.comment-tag {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
}

.tag-review {
  background: #FFF1F0;
  color: #EB5757;
}

.tag-normal {
  background: #E8F8EE;
  color: #27AE60;
}

.comment-time {
  font-size: 22rpx;
  color: #A0917F;
}

.comment-content {
  margin-top: 8rpx;
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #2D2016;
}

.empty {
  margin-top: 12rpx;
  color: #C4B5A5;
  font-size: 24rpx;
}

.comment-editor {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.comment-input {
  flex: 1;
  height: 70rpx;
  border-radius: 35rpx;
  background: #FAF5F0;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.comment-submit {
  margin: 0;
  min-width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  color: #fff;
  font-size: 24rpx;
}

.comment-submit::after {
  border: none;
}
