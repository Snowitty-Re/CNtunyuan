<view class="my-tasks-page">
  <!-- 标签栏 -->
  <view class="tab-strip">
    <view
      class="tab-item {{currentStatus === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text class="tab-label">{{item.label}}</text>
      <view class="tab-badge" wx:if="{{item.count > 0}}">
        <text class="badge-num">{{item.count}}</text>
      </view>
      <view class="tab-indicator" wx:if="{{currentStatus === item.key}}"></view>
    </view>
  </view>

  <!-- 任务列表 -->
  <scroll-view
    class="task-list"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="task-cards">
      <view class="task-card" wx:for="{{tasks}}" wx:key="id">
        <!-- 卡片主体 -->
        <view class="card-main" bindtap="goToDetail" data-id="{{item.id}}">
          <!-- 头部行 -->
          <view class="card-top">
            <text class="card-title">{{item.title}}</text>
            <view class="status-tag status-{{item.status}}">
              <view class="status-dot-mini"></view>
              <text class="status-text-mini">{{statusMap[item.status] || item.status}}</text>
            </view>
          </view>

          <!-- 标签行 -->
          <view class="card-tags">
            <view class="priority-tag priority-{{item.priority}}">
              {{priorityMap[item.priority]}}
            </view>
            <view class="deadline-tag {{item.isOverdue ? 'overdue' : ''}}" wx:if="{{item.deadline}}">
              <text class="dl-icon">T</text>
              <text class="dl-text">截止 {{item.deadline}}</text>
            </view>
          </view>

          <!-- 描述 -->
          <text class="card-desc" wx:if="{{item.description}}">{{item.description}}</text>

          <!-- 关联案件 -->
          <view class="card-case" wx:if="{{item.missing_person}}">
            <view class="case-icon-mini">
              <text class="case-char">案</text>
            </view>
            <text class="case-name-text">{{item.missing_person.name}}</text>
          </view>

          <!-- 进度条 -->
          <view class="card-progress" wx:if="{{item.progress !== undefined && item.progress !== null}}">
            <view class="progress-track">
              <view class="progress-fill" style="width: {{item.progress}}%">
                <view class="progress-shine"></view>
              </view>
            </view>
            <text class="progress-num">{{item.progress}}%</text>
          </view>
        </view>

        <!-- 操作按钮区 -->
        <view class="card-actions" wx:if="{{item.status === 'processing' || item.status === 'pending'}}">
          <block wx:if="{{item.status === 'pending'}}">
            <button class="action-btn btn-primary" bindtap="startTask" data-id="{{item.id}}">
              开始任务
            </button>
          </block>
          <block wx:if="{{item.status === 'processing'}}">
            <button class="action-btn btn-outline" bindtap="updateProgress" data-id="{{item.id}}">
              更新进度
            </button>
            <button class="action-btn btn-success" bindtap="completeTask" data-id="{{item.id}}">
              完成任务
            </button>
          </block>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && tasks.length === 0}}">
      <view class="empty-visual">
        <view class="empty-bg-circle"></view>
        <view class="empty-icon-box">
          <text class="empty-icon-char">!</text>
        </view>
      </view>
      <text class="empty-heading">暂无任务</text>
      <text class="empty-desc">您还没有{{currentStatus === 'processing' ? '进行中' : currentStatus === 'completed' ? '已完成' : ''}}的任务</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-ring-small"></view>
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && tasks.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">没有更多了</text>
      <view class="no-more-line"></view>
    </view>
  </scroll-view>
</view>
