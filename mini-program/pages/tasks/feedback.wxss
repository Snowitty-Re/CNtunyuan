.feedback-page {
  min-height: 100vh;
  background: #FDF8F3;
  padding-bottom: 60rpx;
}

/* ========== 任务头部 ========== */
.task-banner {
  position: relative;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 50%, #FFB085 100%);
  padding: 40rpx 32rpx 36rpx;
  overflow: hidden;
}

.banner-decor {
  position: absolute;
  top: -50rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.banner-content {
  position: relative;
  z-index: 2;
}

.banner-label {
  display: inline-block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.banner-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.banner-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 表单区域 ========== */
.form-area {
  padding: 24rpx;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 74, 58, 0.06);
}

.form-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.form-icon-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-orange { background: #FFF0E5; }
.icon-green { background: #E8F8EE; }
.icon-blue { background: #E6F4FF; }

.form-icon-char {
  font-size: 20rpx;
  font-weight: 800;
}

.icon-orange .form-icon-char { color: #FF8C42; }
.icon-green .form-icon-char { color: #27AE60; }
.icon-blue .form-icon-char { color: #4A90D9; }

.form-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2016;
  flex: 1;
}

.form-required-tag {
  font-size: 20rpx;
  color: #FF4D4F;
  background: #FFF1F0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.form-optional-tag {
  font-size: 20rpx;
  color: #C4B5A5;
  background: #FAF5F0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* ========== 文本域 ========== */
.textarea-container {
  background: #FAF5F0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.textarea-container:focus-within {
  border-color: #FFD4B8;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #2D2016;
  line-height: 1.7;
  box-sizing: border-box;
}

.form-textarea-short {
  min-height: 120rpx;
}

.placeholder-style {
  color: #C4B5A5;
}

.textarea-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 20rpx;
}

.char-progress {
  flex: 1;
  height: 4rpx;
  background: #E8DDD2;
  border-radius: 2rpx;
  overflow: hidden;
}

.char-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42, #FFB085);
  border-radius: 2rpx;
  transition: width 0.2s;
  max-width: 100%;
}

.char-count {
  font-size: 22rpx;
  color: #C4B5A5;
  flex-shrink: 0;
}

/* ========== 图片网格 ========== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(45, 32, 22, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-char {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1;
}

.photo-add {
  width: 196rpx;
  height: 196rpx;
  border: 3rpx dashed #E0D6CC;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #FAF5F0;
  transition: border-color 0.2s;
}

.photo-add:active {
  border-color: #FF8C42;
  background: #FFF7F0;
}

.add-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: #FFE5D0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon-char {
  font-size: 36rpx;
  color: #FF8C42;
  font-weight: 300;
  line-height: 1;
}

.add-count {
  font-size: 22rpx;
  color: #C4B5A5;
}

/* ========== 提交区域 ========== */
.submit-area {
  padding: 20rpx 32rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B2C 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 44, 0.35);
}

.submit-btn::after {
  border: none;
}

.submit-btn.btn-loading {
  opacity: 0.85;
}

.submit-btn[disabled] {
  opacity: 0.75;
}

.btn-loading-ring {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.btn-label {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}
