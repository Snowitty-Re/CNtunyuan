.notification-page {
  min-height: 100vh;
  background: #FDF8F3;
}

/* ========== 顶部 ========== */
.page-header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #FF8C42 0%, #FF6B2B 60%, #FFB085 100%);
}

.header-orb {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  filter: blur(40rpx);
  top: -100rpx;
  right: -80rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 48rpx 32rpx 40rpx;
}

.header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.unread-badge {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(255, 77, 79, 0.4);
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.action-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.15s ease;
}

.action-chip text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
}

.action-chip .iconfont {
  font-size: 22rpx;
}

.action-chip.danger {
  background: rgba(255, 77, 79, 0.25);
}

.chip-hover {
  opacity: 0.7;
}

/* ========== 通知列表 ========== */
.notification-body {
  padding: 20rpx 24rpx;
}

.notification-card {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.03);
  transition: all 0.15s ease;
  position: relative;
}

.notification-card.unread {
  background: #FFFAF5;
  border-left: 6rpx solid #FF8C42;
  box-shadow: 0 2rpx 16rpx rgba(255, 140, 66, 0.08);
}

.card-hover {
  background: #FFF5EE;
}

/* 未读指示器 */
.unread-indicator {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 14rpx;
  height: 14rpx;
  background: #ff4d4f;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(255, 77, 79, 0.4);
}

.notification-card.unread .unread-indicator {
  left: 10rpx;
}

/* 类型图标 */
.type-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.type-icon .iconfont {
  font-size: 36rpx;
}

.type-icon.type-task {
  background: linear-gradient(135deg, #E6F4FF, #BAE7FF);
}

.type-icon.type-task .iconfont {
  color: #1890ff;
}

.type-icon.type-case {
  background: linear-gradient(135deg, #FFF5EE, #FFE4D0);
}

.type-icon.type-case .iconfont {
  color: #FF8C42;
}

.type-icon.type-system {
  background: linear-gradient(135deg, #f5f2ef, #e8e4e0);
}

.type-icon.type-system .iconfont {
  color: #8f959e;
}

/* 内容 */
.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  gap: 16rpx;
}

.notification-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-time {
  font-size: 22rpx;
  color: #c9cdd4;
  flex-shrink: 0;
}

.notification-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 箭头 */
.notification-arrow {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.notification-arrow .iconfont {
  font-size: 24rpx;
  color: #d0ccc8;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 80rpx;
}

.empty-illustration {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-circle {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FFF5EE, #FFE4D0);
  border-radius: 50%;
}

.empty-illustration .iconfont {
  position: relative;
  z-index: 1;
  font-size: 72rpx;
  color: #FFB085;
}

.empty-title {
  font-size: 32rpx;
  color: #2c2c2c;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #b0b0b0;
}

/* ========== 加载 ========== */
.load-footer {
  text-align: center;
  padding: 24rpx 0 16rpx;
}

.load-text {
  font-size: 24rpx;
  color: #c9cdd4;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
