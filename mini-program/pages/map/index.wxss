.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.full-map {
  width: 100%;
  height: 100%;
}

/* ========== 顶部搜索栏 ========== */
.search-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx 0;
  z-index: 100;
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 40rpx;
  padding: 10rpx 12rpx 10rpx 24rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(20rpx);
}

.search-icon-wrap {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-icon-wrap .iconfont {
  font-size: 32rpx;
  color: #FF8C42;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c2c2c;
  height: 60rpx;
}

.search-placeholder {
  color: #c9cdd4;
}

.search-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  border-radius: 28rpx;
  flex-shrink: 0;
}

.search-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* ========== 状态筛选条 ========== */
.filter-overlay {
  position: absolute;
  top: 100rpx;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 0 24rpx;
}

.filter-scroll {
  display: flex;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 14rpx;
  box-shadow: 0 3rpx 14rpx rgba(0, 0, 0, 0.08);
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.filter-chip.active {
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255, 140, 66, 0.3);
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-red { background: #ff4d4f; }
.dot-orange { background: #FF8C42; }
.dot-green { background: #52c41a; }

.filter-chip.active .chip-dot {
  background: rgba(255, 255, 255, 0.8);
}

/* ========== 浮动按钮 ========== */
.float-btns {
  position: absolute;
  right: 24rpx;
  bottom: 260rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 100;
}

.float-btn {
  width: 84rpx;
  height: 84rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.2s ease;
}

.float-hover {
  transform: scale(0.92);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

.float-btn .iconfont {
  font-size: 38rpx;
  color: #FF8C42;
}

.float-btn.spinning .iconfont {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ========== 底部面板 ========== */
.case-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(calc(100% + 40rpx));
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 200;
  max-height: 72vh;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.case-panel.show {
  transform: translateY(0);
}

.panel-handle-area {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.panel-handle {
  width: 60rpx;
  height: 8rpx;
  background: #e0dcd8;
  border-radius: 4rpx;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 20rpx;
}

.panel-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c2c2c;
}

.panel-count-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  background: #FFF0E6;
  color: #FF8C42;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f2ef;
}

.panel-close .iconfont {
  font-size: 28rpx;
  color: #8f959e;
}

/* 案件列表 */
.case-scroll {
  max-height: 55vh;
  padding: 0 24rpx 24rpx;
}

.case-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #FFFAF5;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s ease;
}

.case-card-hover {
  background: #FFF0E6;
}

.case-photo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.case-info {
  flex: 1;
  min-width: 0;
}

.case-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.case-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c2c2c;
}

.case-status-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.case-status-tag.status-missing {
  background: #FFE5E5;
  color: #ff4d4f;
}

.case-status-tag.status-searching {
  background: #FFF5EE;
  color: #FF8C42;
}

.case-status-tag.status-found {
  background: #E6F7E6;
  color: #52c41a;
}

.case-status-tag.status-reunited {
  background: #E6F4FF;
  color: #1890ff;
}

.case-location-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.case-loc-icon {
  font-size: 22rpx;
  color: #b0b0b0;
}

.case-loc-text {
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-time-text {
  font-size: 22rpx;
  color: #b0b0b0;
}

.case-nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-left: 16rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.3);
}

.case-nav-btn .iconfont {
  font-size: 32rpx;
  color: #fff;
}

.nav-label {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

/* 面板空状态 */
.panel-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.panel-empty .empty-illustration {
  width: 120rpx;
  height: 120rpx;
  background: #FFF5EE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.panel-empty .iconfont {
  font-size: 56rpx;
  color: #FFB085;
}

.panel-empty .empty-text {
  font-size: 28rpx;
  color: #b0b0b0;
}

/* ========== 底部操作栏 ========== */
.bottom-actions {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 100;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.bottom-actions.hidden {
  opacity: 0;
  transform: translateY(40rpx);
  pointer-events: none;
}

.action-btn-primary,
.action-btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn-primary {
  background: linear-gradient(135deg, #FF8C42, #FF6B2B);
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.35);
}

.action-btn-primary .iconfont {
  font-size: 32rpx;
}

.action-btn-secondary {
  background: rgba(255, 255, 255, 0.97);
  color: #FF8C42;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.1);
}

.action-btn-secondary .iconfont {
  font-size: 32rpx;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}
