<view class="map-page">
  <map
    id="map"
    class="full-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    include-points="{{includePoints}}"
    show-location
    show-compass
    enable-zoom
    enable-scroll
    enable-rotate
    bindmarkertap="onMarkerTap"
    bindtap="onMapTap"
    bindregionchange="onRegionChange"
  ></map>

  <view class="hero-overlay">
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="hero-title">案件地图</view>
          <view class="hero-subtitle">随地图视野自动更新案件，不再手动切换</view>
        </view>
        <view class="hero-badge">{{visibleCount}}</view>
      </view>

      <view class="hero-stats">
        <view class="hero-stat">
          <text class="hero-stat-value">{{matchedCount}}</text>
          <text class="hero-stat-label">可定位案件</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{visibleCount}}</text>
          <text class="hero-stat-label">当前视野</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{selectedStatusLabel}}</text>
          <text class="hero-stat-label">筛选状态</text>
        </view>
      </view>
    </view>
  </view>

  <view class="filter-overlay">
    <scroll-view class="filter-scroll" scroll-x enable-flex>
      <view class="filter-chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="onStatusChange">全部</view>
      <view class="filter-chip {{status === 'missing' ? 'active' : ''}}" data-status="missing" bindtap="onStatusChange">
        <view class="chip-dot dot-red"></view>
        <text>失踪中</text>
      </view>
      <view class="filter-chip {{status === 'searching' ? 'active' : ''}}" data-status="searching" bindtap="onStatusChange">
        <view class="chip-dot dot-orange"></view>
        <text>寻找中</text>
      </view>
      <view class="filter-chip {{status === 'found' ? 'active' : ''}}" data-status="found" bindtap="onStatusChange">
        <view class="chip-dot dot-green"></view>
        <text>已找到</text>
      </view>
      <view class="filter-chip {{status === 'reunited' ? 'active' : ''}}" data-status="reunited" bindtap="onStatusChange">
        <view class="chip-dot dot-blue"></view>
        <text>已团圆</text>
      </view>
      <view class="filter-chip {{status === 'closed' ? 'active' : ''}}" data-status="closed" bindtap="onStatusChange">
        <view class="chip-dot dot-gray"></view>
        <text>已结案</text>
      </view>
    </scroll-view>
  </view>

  <view class="search-overlay">
    <view class="search-input-wrap">
      <text class="search-icon">搜</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索姓名、地区、详细地址"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">清空</view>
    </view>
  </view>

  <view class="float-btns">
    <view class="float-btn" bindtap="locateCurrentPosition" hover-class="float-hover">
      <text class="float-text">定位</text>
    </view>
    <view class="float-btn {{loading ? 'spinning' : ''}}" bindtap="onRefresh" hover-class="float-hover">
      <text class="float-text">刷新</text>
    </view>
  </view>

  <view class="panel-shell {{panelExpanded ? 'expanded' : 'collapsed'}}">
    <view class="panel-toggle" bindtap="togglePanel">
      <view class="panel-handle"></view>
      <text class="panel-toggle-text">{{panelExpanded ? '收起' : '展开案件面板'}}</text>
    </view>

    <view class="selected-brief" wx:if="{{selectedCase}}">
      <view class="selected-brief-main">
        <text class="selected-brief-name">{{selectedCase.name || '未命名案件'}}</text>
        <text class="selected-brief-location">{{selectedCase.displayLocation}}</text>
      </view>
      <view class="selected-brief-actions">
        <view class="brief-btn ghost" bindtap="focusSelectedCase">定位</view>
        <view class="brief-btn" data-id="{{selectedCase.id}}" bindtap="goToCaseDetail">详情</view>
      </view>
    </view>

    <view class="panel-headline">
      <view>
        <text class="panel-title">当前地图范围内案件</text>
        <text class="panel-desc">拖动或缩放地图后会自动更新</text>
      </view>
      <view class="panel-count">{{visibleCases.length}}</view>
    </view>

    <scroll-view class="case-scroll" scroll-y>
      <block wx:if="{{visibleCases.length > 0}}">
        <view
          class="case-card {{selectedCase && selectedCase.id === item.id ? 'case-card-active' : ''}}"
          wx:for="{{visibleCases}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectCase"
        >
          <image class="case-photo" src="{{item.cover}}" mode="aspectFill" />
          <view class="case-info">
            <view class="case-name-row">
              <text class="case-name">{{item.name || '未命名案件'}}</text>
              <view class="case-status-tag status-{{item.status}}">{{item.status_text}}</view>
            </view>
            <text class="case-location">{{item.displayLocation}}</text>
            <text class="case-time">失踪时间：{{item.missing_time_text}}</text>
          </view>
          <view class="case-side-actions">
            <view class="mini-action" catchtap="selectCase" data-id="{{item.id}}">定位</view>
            <view class="mini-action solid" data-id="{{item.id}}" catchtap="goToCaseDetail">详情</view>
          </view>
        </view>
      </block>

      <view class="panel-empty" wx:else>
        <view class="empty-icon">图</view>
        <text class="empty-title">当前地图范围暂无案件</text>
        <text class="empty-text">可以拖动地图查看附近区域，或调整上方状态筛选</text>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-actions">
    <view class="action-btn-primary" bindtap="goToCreateCase" hover-class="btn-hover">发布案件</view>
  </view>
</view>
